/* ========================================================================= */
/* MANDATO — FLIP-PHONE / LEGACY MOBILE OS                                  */
/*                                                                           */
/* Direção: sistema operacional de celular antigo / software de 2000s.       */
/* Referências conceituais: flip phones, Symbian/Windows Mobile, menus       */
/* monocromáticos/coloridos simples, software institucional antigo.          */
/*                                                                           */
/* REGRA: aparência "ligada/desligada".                                     */
/* - Sem transitions                                                        */
/* - Sem animações suaves                                                   */
/* - Sem gradientes                                                         */
/* - Sem glassmorphism                                                      */
/* - Sem cards modernos                                                     */
/* - Sem border-radius                                                      */
/* - Estados instantâneos                                                   */
/* - Profundidade criada por bordas claras/escuras                           */
/* ========================================================================= */

:root {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');

    width: 100%;
    height: 100%;
    background-color: #080b0d;
}

Label,
Button {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
}

/* ========================================================================= */
/* ROOT / PHONE BODY                                                         */
/* ========================================================================= */

.phone-screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #080b0d;
    padding: 5px;
    box-sizing: border-box;
}

.phone-screen-root.hidden {
    display: none;
    opacity: 0;
}

.phone-chassis {
    width: 100%;
    height: 100%;
    background-color: #171c20;

    /* Hard rectangular frame — no rounded modern container. */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #5e6970;
    border-left-color: #5e6970;
    border-right-color: #090b0d;
    border-bottom-color: #090b0d;

    border-radius: 0;

    padding: 5px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
}

/* ========================================================================= */
/* TOP SYSTEM BAR                                                            */
/* ========================================================================= */

.phone-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    height: 31px;
    min-height: 31px;

    background-color: #20272c;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #69757c;
    border-left-color: #69757c;
    border-right-color: #080a0c;
    border-bottom-color: #080a0c;

    border-radius: 0;

    padding: 2px 5px;
    margin-bottom: 5px;
    flex-shrink: 0;
}

.system-tag-box {
    flex-direction: row;
    align-items: center;
}

.system-status-led {
    width: 7px;
    height: 7px;
    margin-right: 5px;

    background-color: #7ea85a;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #c1d7a2;
    border-left-color: #c1d7a2;
    border-right-color: #3d552e;
    border-bottom-color: #3d552e;

    border-radius: 0;
}

.system-compact-title {
    font-size: 13px;
    color: #d7d9c9;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.phone-close-btn {
    height: 23px;
    min-width: 62px;

    margin: 0;
    padding: 1px 6px;

    background-color: #3a4248;
    color: #e0e3df;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #89939a;
    border-left-color: #89939a;
    border-right-color: #111417;
    border-bottom-color: #111417;

    border-radius: 0;

    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.phone-close-btn:hover {
    /* Instant state change — deliberately old-school. */
    background-color: #5a6268;
    color: #ffffff;
}

.phone-close-btn:active {
    background-color: #1b2024;

    border-top-color: #111417;
    border-left-color: #111417;
    border-right-color: #89939a;
    border-bottom-color: #89939a;
}

/* ========================================================================= */
/* APP / CONTACT WORKSPACE                                                   */
/* ========================================================================= */

.apps-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    background-color: #111518;
}

.apps-grid-container,
.contacts-list-container {
    flex-direction: column;
    width: 100%;
    padding: 3px;
    gap: 4px;
}

/* ========================================================================= */
/* EMPTY STATE                                                               */
/* ========================================================================= */

.empty-actions-label {
    color: #78847b;
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-top: 24px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ========================================================================= */
/* CONTACT ROW — OLD MOBILE ADDRESS BOOK ITEM                                */
/* ========================================================================= */

.contact-row,
.app-tile {
    width: 100%;
    height: 52px;
    min-height: 52px;
    position: relative;

    background-color: #22282c;

    /* Bevel made entirely from hard borders. */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #6e787e;
    border-left-color: #6e787e;
    border-right-color: #0b0e10;
    border-bottom-color: #0b0e10;

    border-radius: 0;

    padding: 3px 6px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
}

/* Selected/focused state: unmistakably active, without animation. */
.contact-row.hovered,
.app-tile.hovered {
    background-color: #38463c;

    border-top-color: #a4b59d;
    border-left-color: #a4b59d;
    border-right-color: #111712;
    border-bottom-color: #111712;
}

.contact-row.hovered .contact-name,
.app-tile.hovered .app-title {
    color: #f1f3dc;
}

.contact-row.hovered .contact-call-badge.badge-call {
    background-color: #4a6744;
    color: #ffffff;
    border-color: #9ab98d;
}

.contact-row:active,
.app-tile:active {
    background-color: #182019;

    border-top-color: #111712;
    border-left-color: #111712;
    border-right-color: #a4b59d;
    border-bottom-color: #a4b59d;
}

/* ========================================================================= */
/* CONTACT ICON BOX                                                          */
/* ========================================================================= */

.contact-icon-box {
    width: 42px;
    height: 42px;
    min-width: 42px;
    margin-right: 7px;

    background-color: #151a1d;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #555f65;
    border-left-color: #555f65;
    border-right-color: #090b0d;
    border-bottom-color: #090b0d;

    border-radius: 0;

    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.contact-icon,
.app-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #e2e4d8;
}

/* Fallback icon */
.contact-fallback-box,
.app-fallback-box {
    width: 34px;
    height: 34px;
    justify-content: center;
    align-items: center;
}

.contact-fallback-symbol {
    font-size: 18px;
    color: #b7c6a8;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.app-fallback-letter {
    font-size: 20px;
    color: #b7c6a8;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ========================================================================= */
/* CONTACT INFO                                                              */
/* ========================================================================= */

.contact-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    margin-right: 5px;
}

.contact-name,
.app-title {
    font-size: 13px;
    color: #d6d9d0;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0;
}

.contact-tag {
    font-size: 8px;
    color: #8c988e;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-top: 1px;
}

/* ========================================================================= */
/* CONTACT CALL BADGE / ACTION STATUS                                        */
/* ========================================================================= */

.contact-call-badge {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 3px 6px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    letter-spacing: 0;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
}

.contact-call-badge.badge-call {
    background-color: #2d3e2b;
    border-color: #63855a;
    color: #c9e6bb;
}

.contact-call-badge.badge-cooldown {
    background-color: #4b3d1b;
    border-color: #8f7737;
    color: #f1de9e;
}

.contact-call-badge.badge-consumed {
    background-color: #24292c;
    border-color: #4c5459;
    color: #798286;
}

.contact-call-badge.badge-unavailable {
    background-color: #3d2325;
    border-color: #784549;
    color: #e5b0b3;
}

/* ========================================================================= */
/* COOLDOWN ROW STATE                                                        */
/* ========================================================================= */

.contact-row.on-cooldown,
.app-tile.on-cooldown {
    opacity: 0.78;
    border-top-color: #5c533e;
    border-left-color: #5c533e;
    border-right-color: #17140e;
    border-bottom-color: #17140e;
    background-color: #26241e;
}

.contact-row.on-cooldown:hover,
.app-tile.on-cooldown:hover {
    opacity: 1;
    background-color: #433b2a;
    border-top-color: #a49469;
    border-left-color: #a49469;
}

.contact-row.on-cooldown:hover .contact-name,
.app-tile.on-cooldown:hover .app-title {
    color: #f1df9e;
}

/* ========================================================================= */
/* CONSUMED ROW STATE                                                        */
/* ========================================================================= */

.contact-row.consumed,
.app-tile.consumed {
    opacity: 0.5;
    border-top-color: #40464a;
    border-left-color: #40464a;
    border-right-color: #111315;
    border-bottom-color: #111315;
    background-color: #181c1e;
}

.contact-row.consumed:hover,
.app-tile.consumed:hover {
    opacity: 0.8;
    background-color: #24292b;
    border-top-color: #636b70;
    border-left-color: #636b70;
}

/* ========================================================================= */
/* UNAVAILABLE ROW STATE                                                     */
/* ========================================================================= */

.contact-row.unavailable,
.app-tile.unavailable {
    opacity: 0.72;
    border-top-color: #583d3f;
    border-left-color: #583d3f;
    border-right-color: #180e0f;
    border-bottom-color: #180e0f;
    background-color: #261c1d;
}

.contact-row.unavailable:hover,
.app-tile.unavailable:hover {
    opacity: 1;
    background-color: #42292a;
    border-top-color: #945d60;
    border-left-color: #945d60;
}

.contact-row.unavailable:hover .contact-name,
.app-tile.unavailable:hover .app-title {
    color: #efc5c5;
}

/* ========================================================================= */
/* ACTION MODAL — OLD MOBILE DIALOG                                         */
/* ========================================================================= */

.action-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    background-color: #090d0f;

    justify-content: flex-end;

    /* Intentionally NO transition. */
}

.action-modal-dialog {
    width: 100%;

    background-color: #252c30;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;

    border-top-color: #7a858b;
    border-left-color: #7a858b;
    border-right-color: #0b0e10;
    border-bottom-color: #0b0e10;

    border-radius: 0;

    padding: 8px;
    box-sizing: border-box;
}

/* ========================================================================= */
/* MODAL HEADER                                                              */
/* ========================================================================= */

.modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 6px;

    border-bottom-width: 1px;
    border-bottom-color: #596267;

    padding-bottom: 5px;
}

.modal-header-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.modal-app-icon {
    width: 42px;
    height: 42px;
    margin-right: 7px;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #e2e4d8;
}

.modal-title-box {
    flex-direction: column;
    justify-content: center;
}

.modal-action-title {
    font-size: 15px;
    color: #e2e4d9;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.modal-category-badge {
    font-size: 8px;
    color: #c9d4c1;

    background-color: #1b211e;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #65715f;
    border-left-color: #65715f;
    border-right-color: #10130f;
    border-bottom-color: #10130f;

    border-radius: 0;

    padding: 1px 4px;
    margin-top: 2px;
    align-self: flex-start;
    -unity-font-style: bold;
}

/* ========================================================================= */
/* MODAL BODY                                                                */
/* ========================================================================= */

.modal-body {
    margin-bottom: 8px;
    min-height: 55px;
    justify-content: center;
    background-color: #151a1d;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #0a0c0e;
    border-left-color: #0a0c0e;
    border-right-color: #596267;
    border-bottom-color: #596267;

    padding: 5px;
}

.modal-action-desc {
    font-size: 11px;
    color: #c8cdc8;
    white-space: normal;
    line-height: 15px;
}

/* ========================================================================= */
/* MODAL BUTTONS                                                             */
/* ========================================================================= */

.modal-footer {
    flex-direction: row;
    justify-content: space-between;
    gap: 5px;
}

.modal-btn {
    height: 30px;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;

    border-top-color: #7d888e;
    border-left-color: #7d888e;
    border-right-color: #111416;
    border-bottom-color: #111416;

    border-radius: 0;

    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
    margin: 0;
}

.modal-btn:hover {
    background-color: #465158;
}

.modal-btn:active {
    border-top-color: #111416;
    border-left-color: #111416;
    border-right-color: #7d888e;
    border-bottom-color: #7d888e;
}

.modal-back-btn {
    flex-grow: 1;
    background-color: #3b4348;
    color: #d4d8d5;
}

.modal-back-btn:hover {
    background-color: #525c62;
    color: #ffffff;
}

.modal-back-btn:active {
    background-color: #262c30;
}

.modal-exec-btn {
    flex-grow: 1.4;
    background-color: #4d653d;
    color: #edf2df;
}

.modal-exec-btn:hover {
    background-color: #617c4d;
    color: #ffffff;
}

.modal-exec-btn:active {
    background-color: #2c3825;
}

.modal-exec-btn.btn-disabled {
    background-color: #292e30;
    color: #626967;

    border-top-color: #4b5356;
    border-left-color: #4b5356;
    border-right-color: #111315;
    border-bottom-color: #111315;
}

.modal-exec-btn.btn-disabled:hover {
    background-color: #292e30;
    color: #626967;
}

/* ========================================================================= */
/* HIDDEN                                                                    */
/* ========================================================================= */

.hidden {
    display: none;
    visibility: hidden;
    opacity: 0;
}
