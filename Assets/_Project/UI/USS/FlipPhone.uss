/* ========================================================================= */
/* FLIP-PHONE / DISPOSITIVO DE GABINETE - ESTILOS UI TOOLKIT                 */
/* ========================================================================= */

.phone-screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #060a0f;
    padding: 0;
    margin: 0;
}

.phone-screen-root.hidden {
    display: none;
    opacity: 0;
}

/* CHASSI / TELA DO CELULAR */
.phone-chassis {
    width: 100%;
    height: 100%;
    background-color: #090e14;
    padding: 12px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

/* COMPACT TOP BAR */
.phone-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #1a2d3a;
    margin-bottom: 8px;
    flex-shrink: 0;
    height: 32px;
}

.top-title-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    overflow: hidden;
}

.status-led {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #00ffaa;
    margin-right: 6px;
    flex-shrink: 0;
}

.status-network-text {
    font-size: 11px;
    -unity-font-style: bold;
    color: #38bdf8;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

.status-close-btn {
    background-color: #141f28;
    border-width: 1px;
    border-color: #2a3f4e;
    border-radius: 6px;
    color: #94a3b8;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 4px 10px;
    margin: 0;
    flex-shrink: 0;
    height: 26px;
}

.status-close-btn:hover {
    background-color: #dc2626;
    border-color: #ef4444;
    color: #ffffff;
}

/* CATEGORY TABS / CHIPS */
.category-tabs-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
    height: 28px;
    gap: 4px;
}

.category-tab-btn {
    flex-grow: 1;
    flex-basis: 0;
    background-color: #101922;
    border-width: 1px;
    border-color: #1f3242;
    border-radius: 6px;
    padding: 0;
    height: 28px;
    color: #7dd3fc;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
}

.category-tab-btn:hover {
    background-color: #1a2c3a;
    color: #e0f2fe;
    border-color: #38bdf8;
}

.category-tab-btn.active {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

/* LISTA DE AÇÕES (SCROLLVIEW) */
.actions-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 6px;
    overflow: hidden;
}

.actions-list-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

/* EMPTY STATE */
.empty-actions-label {
    color: #64748b;
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-top: 30px;
    -unity-font-style: italic;
}

/* CARD / ITEM DE AÇÃO */
.action-item-card {
    background-color: #0d151e;
    border-width: 1px;
    border-color: #1e2e3c;
    border-radius: 8px;
    padding: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.action-item-card:hover {
    background-color: #131e2b;
    border-color: #2e4a60;
}

.action-item-card.on-cooldown {
    opacity: 0.65;
    background-color: #0a1017;
    border-color: #15222d;
}

.action-item-card.consumed {
    opacity: 0.4;
    background-color: #070b10;
    border-color: #101920;
}

.action-info-col {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
    overflow: hidden;
}

.action-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    flex-wrap: nowrap;
}

.action-category-badge {
    background-color: #162a38;
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #38bdf8;
    margin-right: 6px;
    flex-shrink: 0;
}

.action-item-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f1f5f9;
    flex-shrink: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.action-item-desc {
    font-size: 10px;
    color: #94a3b8;
    white-space: normal;
    margin-bottom: 4px;
    line-height: 13px;
}

.action-tags-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4px;
}

.action-impact-chip {
    background-color: #122822;
    border-radius: 3px;
    padding: 1px 5px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #4ade80;
}

.action-impact-chip.negative {
    color: #f87171;
    background-color: #2a1518;
}

/* BOTÃO DE USAR AÇÃO */
.action-exec-btn {
    min-width: 88px;
    height: 32px;
    background-color: #059669;
    border-width: 1px;
    border-color: #10b981;
    border-radius: 6px;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin: 0;
}

.action-exec-btn:hover {
    background-color: #10b981;
    border-color: #34d399;
}

.action-exec-btn:active {
    background-color: #047857;
}

.action-exec-btn.btn-cooldown {
    background-color: #1e293b;
    border-color: #334155;
    color: #64748b;
    font-size: 9px;
}

.action-exec-btn.btn-consumed {
    background-color: #141a23;
    border-color: #1e2632;
    color: #475569;
    font-size: 9px;
}

/* FOOTER STATUS BAR */
.phone-footer-bar {
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #1a2d3a;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 24px;
}

.phone-status-message {
    font-size: 10px;
    color: #64748b;
    -unity-font-style: italic;
    flex-grow: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.phone-status-message.success {
    color: #34d399;
    -unity-font-style: bold;
}

.phone-status-message.error {
    color: #f87171;
    -unity-font-style: bold;
}
