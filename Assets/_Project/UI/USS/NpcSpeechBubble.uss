/* =========================================================================
   MANDATO — NPC Speech Bubble HUD (UI Toolkit)
   Estilização de balão de fala posicionado como footer (30% altura da tela)
   com largura de aproximadamente 65% (entre 60% e 70% da tela), centralizado,
   texto com alinhamento centralizado e botão de avançar no canto direito.
   ========================================================================= */

/* --- ROOT CONTAINER (Tela Toda / HUD) --- */
.speech-hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

/* --- FOOTER CONTAINER (30% Altura da Tela, ~80% Largura Centralizado) --- */
.speech-footer-container {
    position: relative;
    width: 80%;
    min-width: 75%;
    max-width: 88%;
    height: 30%;
    min-height: 180px;
    max-height: 360px;
    align-self: center;
    margin-bottom: 12px;
    padding: 10px 24px 16px 24px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.speech-footer-container.hidden {
    display: none;
    opacity: 0;
    translate: 0 30px;
}

/* --- BALÃO DE FALA — FUNDO COM SPRITE --- */
.speech-bubble-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('project://database/Assets/Sprites/papeis-pergunta.png?fileID=21300000&guid=e09be14377a08b64fbba6f4c66361c5d&type=3#papeis-pergunta');
    -unity-background-scale-mode: stretch-to-fill;
}

/* Caso queira inverter horizontalmente via script ou classe */
.speech-bubble-bg.flip-left {
    scale: -1 1;
    transform-origin: center;
}

/* --- CAMADA DE CONTEÚDO (Layout horizontal com proteção de bordas do papel) --- */
.speech-bubble-content {
    position: relative;
    width: 100%;
    height: 100%;
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 36px;
    padding-right: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* --- ÁREA DE TEXTO (Centralizada) --- */
.speech-text-area {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding-left: 48px;
    padding-right: 48px;
}

/* --- CABEÇALHO DO INTERLOCUTOR (Nome do NPC / Cargo) --- */
.speech-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 10px;
}

.speaker-badge {
    -unity-font-definition: url('project://database/Assets/Bitter-Bold.ttf?fileID=12800000&guid=32d9e41abd45fa44e83666ff94f58cd0&type=3#Bitter-Bold');
    background-color: #18181B;
    color: #F4F4F5;
    padding: 8px 26px;
    border-radius: 10px;
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    border-width: 2px;
    border-color: #27272A;
    -unity-text-align: middle-center;
}

.speaker-badge.hidden {
    display: none;
}

/* --- CORPO DO TEXTO DE DIÁLOGO --- */
.speech-scroll-view {
    flex-grow: 1;
    width: 100%;
    margin-top: 2px;
    margin-bottom: 2px;
}

.speech-scroll-view #unity-content-container {
    justify-content: center;
    align-items: center;
    width: 100%;
}

/* Oculta completamente a barra de rolagem horizontal */
.speech-scroll-view #unity-low-button {
    display: none;
}

.speech-scroll-view #unity-high-button {
    display: none;
}

.speech-scroll-view .unity-scroller--horizontal {
    display: none;
    opacity: 0;
    height: 0;
}

.speech-text-label {
    -unity-font-definition: url('project://database/Assets/Bitter-Bold.ttf?fileID=12800000&guid=32d9e41abd45fa44e83666ff94f58cd0&type=3#Bitter-Bold');
    color: #111827;
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    align-self: center;
}

/* =========================================================================
   ÁREA DO BOTÃO CONTINUAR — CANTO DIREITO (Estilo DecisionUI)
   ========================================================================= */

.speech-action-area {
    position: absolute;
    right: 24px;
    top: 0;
    bottom: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.speech-advance-btn.hidden {
    display: none;
}

.decision-btn {
    /* Base para interoperabilidade */
}

.decision-btn-circle {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    border-width: 3.5px;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.decision-btn-circle:hover {
    scale: 1.08 1.08;
}

.decision-btn-circle:active {
    scale: 0.92 0.92;
}

.btn-continue {
    border-color: #94A3B8;
    background-color: rgba(30, 41, 59, 0.94);
}

.btn-continue:hover {
    border-color: #F8FAFC;
    background-color: rgba(51, 65, 85, 0.98);
}

.decision-icon {
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.icon-continue {
    background-image: url('project://database/Assets/Sprites/white-arrow.png?fileID=2800000&guid=13a8b3e5edbbfb14889ba1dd7b595f97&type=3#white-arrow');
    -unity-background-image-tint-color: #E2E8F0;
    scale: -1 1; /* Espelha a seta horizontalmente para apontar para a direita */
}

.btn-continue:hover .icon-continue {
    -unity-background-image-tint-color: #FFFFFF;
}
