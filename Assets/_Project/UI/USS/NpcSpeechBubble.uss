/* =========================================================================
   MANDATO — NPC Speech Bubble HUD (UI Toolkit)
   Estilização de balão de fala posicionado como footer (30% altura da tela)
   com largura total (100%), botão de continuar estilizado do DecisionUI
   encaixado no canto direito e área de texto delimitada sem sobreposição.
   ========================================================================= */

/* --- ROOT CONTAINER (Tela Toda / HUD) --- */
.speech-hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
    pointer-events: none;
}

/* --- FOOTER CONTAINER (30% Altura da Tela, 100% Largura) --- */
.speech-footer-container {
    position: relative;
    width: 100%;
    height: 30%;
    min-height: 180px;
    max-height: 360px;
    padding: 10px 24px 16px 24px;
    box-sizing: border-box;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    pointer-events: none;
}

.speech-footer-container.hidden {
    display: none;
    opacity: 0;
    translate: 0 30px;
}

/* --- BALÃO DE FALA — FUNDO COM SPRITE --- */
.speech-bubble-bg {
    position: absolute;
    top: 0;
    left: 12px;
    right: 12px;
    bottom: 6px;
    background-image: url('project://database/Assets/Sprites/papeis-pergunta.png?fileID=21300000&guid=e09be14377a08b64fbba6f4c66361c5d&type=3#papeis-pergunta');
    -unity-background-scale-mode: stretch-to-fill;
    pointer-events: none;
}

/* Caso queira inverter horizontalmente via script ou classe */
.speech-bubble-bg.flip-left {
    scale: -1 1;
    transform-origin: center;
}

/* --- CAMADA DE CONTEÚDO (Layout horizontal com proteção de bordas do papel) --- */
.speech-bubble-content {
    position: relative;
    width: 100%;
    height: 100%;
    padding-top: 32px;
    padding-bottom: 26px;
    padding-left: 56px;
    padding-right: 56px;
    box-sizing: border-box;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* --- ÁREA DE TEXTO (Limitada para nunca colidir com o botão da direita) --- */
.speech-text-area {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    margin-right: 24px;
    justify-content: center;
    flex-direction: column;
}

/* --- CABEÇALHO DO INTERLOCUTOR (Nome do NPC / Cargo) --- */
.speech-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 4px;
}

.speaker-badge {
    background-color: #18181B;
    color: #F4F4F5;
    padding: 3px 12px;
    border-radius: 4px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-width: 1px;
    border-color: #27272A;
}

.speaker-badge.hidden {
    display: none;
}

/* --- CORPO DO TEXTO DE DIÁLOGO --- */
.speech-scroll-view {
    flex-grow: 1;
    margin-top: 2px;
    margin-bottom: 2px;
}

.speech-text-label {
    color: #111827;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-left;
    line-height: 26px;
}

/* =========================================================================
   ÁREA DO BOTÃO CONTINUAR — CANTO DIREITO CENTRALIZADO (Estilo DecisionUI)
   ========================================================================= */

.speech-action-area {
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    height: 100%;
    padding-right: 8px;
    pointer-events: auto;
}

.decision-btn {
    /* Base para interoperabilidade */
}

.decision-btn-circle {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    border-width: 3.5px;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.decision-btn-circle:hover {
    scale: 1.08 1.08;
}

.decision-btn-circle:active {
    scale: 0.92 0.92;
}

.btn-continue {
    border-color: #94A3B8;
    background-color: rgba(30, 41, 59, 0.94);
}

.btn-continue:hover {
    border-color: #F8FAFC;
    background-color: rgba(51, 65, 85, 0.98);
}

.decision-icon {
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.icon-continue {
    background-image: url('project://database/Assets/Sprites/white-arrow.png?fileID=2800000&guid=13a8b3e5edbbfb14889ba1dd7b595f97&type=3#white-arrow');
    -unity-background-image-tint-color: #E2E8F0;
    scale: -1 1; /* Espelha a seta horizontalmente para apontar para a direita */
}

.btn-continue:hover .icon-continue {
    -unity-background-image-tint-color: #FFFFFF;
}
