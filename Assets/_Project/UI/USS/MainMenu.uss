.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

.company-logo {
    position: absolute;
    bottom: 40px;
    left: 48px;
    width: 220px;
    height: 220px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/logo_branco.png?fileID=21300000&guid=509ec6a80302b1e4683b87844705c751&type=3#logo_branco");
    opacity: 0.9;
    transition-property: opacity, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.company-logo:hover {
    opacity: 1;
    scale: 1.05 1.05;
}

.company-logo:active {
    opacity: 0.8;
    scale: 0.95 0.95;
}

.menu-main-container {
    width: 1200px;
    max-width: 95%;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.menu-logo {
    width: 1100px;
    height: 266px;
    max-width: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/LOGO.png?fileID=21300000&guid=40ea74febf0b57946a2a4319bc0ffd19&type=3#LOGO");
    margin-bottom: 52px;
}

.menu-buttons-container {
    width: 100%;
    align-items: center;
    justify-content: center;
}

.menu-btn {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    scale: 1 0.9;
}

.menu-btn:hover {
    scale: 1.06 0.95;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.menu-btn:active {
    scale: 0.94 0.85;
    -unity-background-image-tint-color: rgb(209, 213, 219);
}

.btn-play {
    width: 480px;
    height: 140px;
    margin-top: 14px;
    margin-bottom: 18px;
    background-image: url("project://database/Assets/Sprites/jogar.png?fileID=21300000&guid=d81ccc80383fb1347b62fa8732d61534&type=3#jogar");
}

.btn-credits {
    width: 420px;
    height: 125px;
    margin-top: 14px;
    margin-bottom: 18px;
    background-image: url("project://database/Assets/Sprites/cr%C3%A9ditos.png?fileID=21300000&guid=0d16c950cb99c724891a288e8ec2d3bf&type=3#créditos");
}

.btn-quit {
    width: 420px;
    height: 125px;
    margin-top: 14px;
    margin-bottom: 14px;
    background-image: url("project://database/Assets/Sprites/sair.png?fileID=21300000&guid=9a0dc5db918be1347b2741d74719c9b3&type=3#sair");
}

.credits-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(5, 10, 20, 0.88);
    justify-content: center;
    align-items: center;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.credits-modal-overlay.open {
    display: flex;
    opacity: 1;
}

.credits-modal-card {
    width: 820px;
    max-height: 85%;
    background-color: rgb(15, 23, 42);
    border-radius: 24px;
    border-width: 3px;
    border-color: rgb(245, 158, 11);
    padding: 36px 44px 28px 44px;
    align-items: center;
}

.credits-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(251, 191, 36);
    letter-spacing: 3px;
    margin-bottom: 26px;
    -unity-text-align: middle-center;
}

.credits-body {
    width: 100%;
    margin-bottom: 8px;
}

.credits-section {
    margin-bottom: 20px;
    align-items: center;
}

.credits-role {
    font-size: 20px;
    color: rgb(52, 211, 153);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.credits-names {
    font-size: 22px;
    color: rgb(241, 245, 249);
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
}

.credits-footer {
    width: 100%;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 4px;
}

.btn-credits-close {
    width: 160px;
    height: 94px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Sprites/botao_voltar.png?fileID=21300000&guid=c4e7dd2b81bc50543b0c4723bc72ec4b&type=3#botao_voltar");
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    scale: 1 0.9;
}

.btn-credits-close:hover {
    scale: 1.06 0.95;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.btn-credits-close:active {
    scale: 0.94 0.85;
    -unity-background-image-tint-color: rgb(209, 213, 219);
}
