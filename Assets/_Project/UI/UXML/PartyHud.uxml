<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/USS/PartyHud.uss" />
    <ui:VisualElement name="party-hud-root" class="party-hud-root" picking-mode="Ignore">
        
        <!-- Barra Superior: Botão Voltar (durante diálogo) e Botão Sair da Festa (discreto à direita) -->
        <ui:VisualElement name="party-top-bar" class="party-top-bar" picking-mode="Ignore">
            <ui:Button name="btn-back-conversation" text="⮌ Salão Principal" class="btn-back-conversation hidden" />
            <ui:VisualElement class="top-spacer" picking-mode="Ignore" />
            <ui:Button name="btn-end-party" text="🚪 Deixar o Jantar" class="btn-end-party" />
        </ui:VisualElement>

        <!-- Feedback Central de Relação (+2 Relação / -1 Relação) -->
        <ui:VisualElement name="feedback-container" class="feedback-container hidden" picking-mode="Ignore">
            <ui:Label name="approach-feedback-label" text="+2 Relação" class="approach-feedback-label" />
        </ui:VisualElement>

        <!-- Medidor Vertical de Ânimo (Canto Inferior Esquerdo) -->
        <ui:VisualElement name="energy-gauge-widget" class="energy-gauge-widget" picking-mode="Ignore">
            <ui:VisualElement class="gauge-header" picking-mode="Ignore">
                <ui:Label text="🍸" class="gauge-icon" />
                <ui:Label text="ÂNIMO" class="gauge-title" />
            </ui:VisualElement>
            <ui:VisualElement class="gauge-meter-frame" picking-mode="Ignore">
                <ui:VisualElement name="energy-bar" class="energy-bar-vertical" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="energy-count-label" text="4/4" class="gauge-count-label" />
        </ui:VisualElement>

        <!-- Área Inferior: Balão de Fala + Roda Circular de Abordagem -->
        <ui:VisualElement name="party-bottom-area" class="party-bottom-area" picking-mode="Ignore">
            
            <!-- Balão / Cartão de Conversa com o Convidado -->
            <ui:VisualElement name="npc-speech-bubble" class="npc-speech-bubble hidden">
                <ui:VisualElement class="bubble-header" picking-mode="Ignore">
                    <ui:Label name="npc-name-label" text="Nome do Convidado" class="npc-name-label" />
                    <ui:VisualElement class="bubble-tag" picking-mode="Ignore">
                        <ui:Label text="CONVERSA PRESENCIAL" class="bubble-tag-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="npc-speech-text" text="Texto da conversa com o convidado..." class="npc-speech-text" />
            </ui:VisualElement>

            <!-- A Verdadeira Roda de Abordagem Triangular em X (Opção A: Canvas Vetorial Painter2D) -->
            <ui:VisualElement name="approach-wheel" class="approach-wheel hidden">
                <!-- Canvas vetorial nativo onde as 4 fatias triangulares cortadas em X são renderizadas -->
                <ui:VisualElement name="wheel-slice-canvas" class="wheel-slice-canvas" picking-mode="Ignore" />

                <!-- Conteúdo do Setor Superior: Arrogante -->
                <ui:VisualElement name="slice-content-up" class="slice-content slice-up" picking-mode="Ignore">
                    <ui:Label text="ARROGANTE" class="quadrant-title" />
                </ui:VisualElement>

                <!-- Conteúdo do Setor Direito: Brincalhão -->
                <ui:VisualElement name="slice-content-right" class="slice-content slice-right" picking-mode="Ignore">
                    <ui:Label text="BRINCALHÃO" class="quadrant-title" />
                </ui:VisualElement>

                <!-- Conteúdo do Setor Inferior: Persuasivo -->
                <ui:VisualElement name="slice-content-down" class="slice-content slice-down" picking-mode="Ignore">
                    <ui:Label text="PERSUASIVO" class="quadrant-title" />
                </ui:VisualElement>

                <!-- Conteúdo do Setor Esquerdo: Romântico -->
                <ui:VisualElement name="slice-content-left" class="slice-content slice-left" picking-mode="Ignore">
                    <ui:Label text="ROMÂNTICO" class="quadrant-title" />
                </ui:VisualElement>

                <!-- Selo / Medalhão Central em Latão Envelhecido -->
                <ui:VisualElement class="wheel-center-seal" picking-mode="Ignore">
                    <ui:Label text="POSTURA" class="seal-text" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
