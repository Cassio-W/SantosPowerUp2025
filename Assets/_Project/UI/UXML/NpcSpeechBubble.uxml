<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/USS/NpcSpeechBubble.uss?fileID=7433441132597879392&amp;guid=068193c9a87abf74fb8f74adbf595d27&amp;type=3#NpcSpeechBubble"/>
    <ui:VisualElement name="speech-hud-root" picking-mode="Ignore" class="speech-hud-root" style="align-items: center; justify-content: flex-end;">
        <ui:VisualElement name="speech-footer-container" class="speech-footer-container hidden" style="width: 80%; display: none;">
            <ui:VisualElement name="speech-bubble-bg" picking-mode="Position" class="speech-bubble-bg"/>
            <ui:VisualElement name="speech-bubble-content" class="speech-bubble-content">
                <ui:VisualElement name="speech-text-area" class="speech-text-area">
                    <ui:VisualElement name="speech-header-row" class="speech-header-row" style="justify-content: center; align-items: center;">
                        <ui:Label name="speaker-badge" text="Secretário" class="speaker-badge" style="-unity-text-align: middle-center;"/>
                    </ui:VisualElement>
                    <ui:ScrollView name="speech-scroll-view" class="speech-scroll-view" horizontal-scroller-visibility="Hidden" mode="Vertical">
                        <ui:Label name="speech-text-label" text="Texto de diálogo do NPC recebido via script..." class="speech-text-label" style="-unity-text-align: middle-center;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>