<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="DecisionUI.uss" />
    <ui:VisualElement name="decision-screen" class="decision-screen" picking-mode="Ignore">
        
        <!-- Vinheta de Corrupção Reativa em Tela Cheia -->
        <ui:VisualElement name="vignette-corruption" class="vignette-corruption" picking-mode="Ignore" />

        <!-- Header de Data (Calendário) no Topo Direito -->
        <ui:VisualElement name="header-date-container" class="header-date-container" picking-mode="Ignore">
            <ui:Label name="header-date-label" class="header-date-label" text="01/2026" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Container dos Perks no Topo Esquerdo (Empilhados Verticalmente) -->
        <ui:VisualElement name="perks-container" class="perks-container" picking-mode="Ignore" />

        <!-- Modal / Tooltip Flutuante dos Perks (Sempre renderizado na frente dos cards) -->
        <ui:VisualElement name="perk-modal-popup" class="perk-modal" picking-mode="Ignore">
            <ui:VisualElement class="perk-modal-header" picking-mode="Ignore">
                <ui:Label name="perk-modal-title" class="perk-modal-title" text="Vantagem Ativa" picking-mode="Ignore" />
                <ui:Label name="perk-modal-tag" class="perk-modal-tag" text="PERK" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="perk-modal-desc" class="perk-modal-desc" text="Descrição do efeito" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Container do Botão Voltar no Canto Inferior Esquerdo -->
        <ui:VisualElement name="back-container" class="back-container hidden" picking-mode="Ignore">
            <ui:VisualElement name="wrapper-back" class="decision-btn-wrapper" picking-mode="Ignore">
                <ui:Button name="btn-back" class="decision-btn decision-btn-circle btn-back" picking-mode="Position">
                    <ui:VisualElement class="decision-icon icon-back" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label name="lbl-back-text" text="Voltar" class="decision-btn-label label-back" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
