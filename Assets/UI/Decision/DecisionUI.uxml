<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="DecisionUI.uss" />
    <ui:VisualElement name="decision-screen" class="decision-screen" picking-mode="Ignore">
        <ui:VisualElement name="decision-container" class="decision-container hidden" picking-mode="Ignore">
            
            <!-- Botão Aceitar (Circular Esquerda - Modo Normal) -->
            <ui:VisualElement name="wrapper-approve" class="decision-btn-wrapper" picking-mode="Ignore">
                <ui:Button name="btn-approve" class="decision-btn decision-btn-circle btn-approve" picking-mode="Position">
                    <ui:VisualElement class="decision-icon icon-approve" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label name="lbl-approve-text" text="Aceitar" class="decision-btn-label label-approve" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Botão Recusar (Circular Direita - Modo Normal) -->
            <ui:VisualElement name="wrapper-reject" class="decision-btn-wrapper" picking-mode="Ignore">
                <ui:Button name="btn-reject" class="decision-btn decision-btn-circle btn-reject" picking-mode="Position">
                    <ui:VisualElement class="decision-icon icon-reject" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label name="lbl-reject-text" text="Recusar" class="decision-btn-label label-reject" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Botão Continuar (Circular Neutro - Modo Tutorial) -->
            <ui:VisualElement name="wrapper-continue" class="decision-btn-wrapper" picking-mode="Ignore" style="display: none;">
                <ui:Button name="btn-continue" class="decision-btn decision-btn-circle btn-continue" picking-mode="Position">
                    <ui:VisualElement class="decision-icon icon-continue" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label name="lbl-continue-text" text="Continuar" class="decision-btn-label label-continue" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
