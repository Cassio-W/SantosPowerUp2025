/* ==========================================================================
   DECISION UI - BOTÕES CIRCULARES COMIC / RETRO STYLIZED (UI TOOLKIT)
   ========================================================================== */

.decision-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: flex-end;
    background-color: rgba(0, 0, 0, 0);
}

.decision-container {
    position: absolute;
    bottom: 40px;
    right: 48px;
    left: auto;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
    translate: 0 0;
    opacity: 1;
}

/* Estado Oculto (Slide-down com Fade) */
.decision-container.hidden {
    translate: 0 160px;
    opacity: 0;
    display: none;
}

/* ==========================================================================
   WRAPPER & ESTRUTURA DOS BOTÕES CIRCULARES
   ========================================================================== */

.decision-btn-wrapper {
    flex-direction: column;
    align-items: center;
    position: relative;
    margin-left: 14px;
    margin-right: 14px;
}

.decision-btn {
    /* Base para interoperabilidade com scripts */
}

.decision-btn-circle {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 4px;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.decision-btn-circle:hover {
    scale: 1.1 1.1;
}

.decision-btn-circle:active {
    scale: 0.92 0.92;
}

/* ==========================================================================
   ÍCONES INTERNOS
   ========================================================================== */

.decision-icon {
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

/* ==========================================================================
   BOTÃO ACEITAR (VERDE ESMERALDA / CHECKMARK)
   ========================================================================== */

.btn-approve {
    border-color: #10B981;
    background-color: rgba(12, 36, 26, 0.94);
}

.btn-approve:hover {
    border-color: #34D399;
    background-color: rgba(16, 56, 38, 0.98);
}

.icon-approve {
    background-image: url('project://database/Assets/Sprites/Gemini_Generated_Image_l7ja3ml7ja3ml7ja-removebg-preview.png?fileID=21300000&guid=8fe4466972b92db4b871a18536e036bd&type=3#Gemini_Generated_Image_l7ja3ml7ja3ml7ja-removebg-preview');
    -unity-background-image-tint-color: #34D399;
}

.btn-approve:hover .icon-approve {
    -unity-background-image-tint-color: #FFFFFF;
}

/* ==========================================================================
   BOTÃO RECUSAR (VERMELHO RUBI / X)
   ========================================================================== */

.btn-reject {
    border-color: #EF4444;
    background-color: rgba(45, 14, 20, 0.94);
}

.btn-reject:hover {
    border-color: #F87171;
    background-color: rgba(65, 18, 28, 0.98);
}

.icon-reject {
    background-image: url('project://database/Assets/Sprites/Gemini_Generated_Image_elpjelpjelpjelpj-removebg-preview_1.png?fileID=21300000&guid=edca1ba3ccc5e0d49afa69481546bde0&type=3#Gemini_Generated_Image_elpjelpjelpjelpj-removebg-preview_1');
    -unity-background-image-tint-color: #F87171;
}

.btn-reject:hover .icon-reject {
    -unity-background-image-tint-color: #FFFFFF;
}

/* ==========================================================================
   LABEL INFORMATIVO / DESCRITIVO ABAIXO DO BOTÃO ("ACEITAR" / "RECUSAR")
   ========================================================================== */

.decision-btn-label {
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 8px;
    max-width: 130px;
    white-space: normal;
    -unity-text-align: upper-center;
    letter-spacing: 1.5px;
}

.label-approve {
    color: #34D399;
}

.label-reject {
    color: #F87171;
}

/* ==========================================================================
   BOTÃO CONTINUAR (NEUTRO / SETA ESPELHADA - MODO TUTORIAL)
   ========================================================================== */

.btn-continue {
    border-color: #94A3B8;
    background-color: rgba(30, 41, 59, 0.94);
}

.btn-continue:hover {
    border-color: #F8FAFC;
    background-color: rgba(51, 65, 85, 0.98);
}

.icon-continue {
    background-image: url('project://database/Assets/Sprites/white-arrow.png');
    -unity-background-image-tint-color: #E2E8F0;
    scale: -1 1; /* Espelha a seta horizontalmente para apontar para a direita */
}

.btn-continue:hover .icon-continue {
    -unity-background-image-tint-color: #FFFFFF;
}

.label-continue {
    color: #E2E8F0;
}
