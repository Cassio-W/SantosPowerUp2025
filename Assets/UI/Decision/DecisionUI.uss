/* ==========================================================================
   DECISION UI - BOTÃO VOLTAR E HUD DE GABINETE (UI TOOLKIT)
   ========================================================================== */

.decision-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: flex-start;
    background-color: rgba(0, 0, 0, 0);
}

/* ==========================================================================
   BACK CONTAINER - CANTO INFERIOR ESQUERDO
   ========================================================================== */

.back-container {
    position: absolute;
    bottom: 40px;
    left: 48px;
    right: auto;
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-start;
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
    translate: 0 0;
    opacity: 1;
}

/* Estado Oculto (Slide-down com Fade) */
.back-container.hidden {
    translate: 0 160px;
    opacity: 0;
    display: none;
}

/* ==========================================================================
   WRAPPER & ESTRUTURA DOS BOTÕES CIRCULARES
   ========================================================================== */

.decision-btn-wrapper {
    flex-direction: column;
    align-items: center;
    position: relative;
    margin-left: 14px;
    margin-right: 14px;
}

.decision-btn {
    /* Base para interoperabilidade com scripts e raycast */
}

.decision-btn-circle {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 4px;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.decision-btn-circle:hover {
    scale: 1.1 1.1;
}

.decision-btn-circle:active {
    scale: 0.92 0.92;
}

/* ==========================================================================
   ÍCONES INTERNOS
   ========================================================================== */

.decision-icon {
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

/* ==========================================================================
   BOTÃO VOLTAR (CANTO INFERIOR ESQUERDO)
   ========================================================================== */

.btn-back {
    border-color: #64748B;
    background-color: rgba(15, 23, 42, 0.94);
}

.btn-back:hover {
    border-color: #94A3B8;
    background-color: rgba(30, 41, 59, 0.98);
}

.btn-back:active {
    border-color: #CBD5E1;
    background-color: rgba(51, 65, 85, 0.98);
}

.icon-back {
    background-image: url('project://database/Assets/Sprites/botao_voltar.png?fileID=21300000&guid=c4e7dd2b81bc50543b0c4723bc72ec4b&type=3#botao_voltar');
    -unity-background-image-tint-color: #CBD5E1;
}

.btn-back:hover .icon-back {
    -unity-background-image-tint-color: #FFFFFF;
}

/* ==========================================================================
   LABEL INFORMATIVO ABAIXO DO BOTÃO ("VOLTAR")
   ========================================================================== */

.decision-btn-label {
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 8px;
    max-width: 130px;
    white-space: normal;
    -unity-text-align: upper-center;
    letter-spacing: 1.5px;
}

.label-back {
    color: #CBD5E1;
}

/* ==========================================================================
   PERKS CONTAINER - TOPO ESQUERDO EMPILHADOS VERTICALMENTE
   ========================================================================== */

.perks-container {
    position: absolute;
    top: 28px;
    left: 32px;
    right: auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
}

.perk-item {
    position: relative;
    align-items: flex-start;
}

/* Card Circular/Quadrado Grande do Ícone */
.perk-icon-card {
    width: 78px;
    height: 78px;
    border-radius: 20px;
    background-color: rgba(15, 23, 42, 0.95);
    border-width: 3.5px;
    border-color: #F59E0B;
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.perk-item:hover .perk-icon-card {
    scale: 1.08 1.08;
    border-color: #FBBF24;
    background-color: rgba(30, 41, 59, 0.98);
}

.perk-icon-large {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Modal / Tooltip abaixo do Ícone ao passar o mouse */
.perk-modal {
    position: absolute;
    top: 90px;
    left: 0;
    right: auto;
    width: 420px;
    background-color: rgba(13, 20, 36, 0.98);
    border-width: 3px;
    border-color: #F59E0B;
    border-radius: 18px;
    padding: 18px 22px;
    opacity: 0;
    display: none;
    translate: 0 -10px;
    scale: 0.95 0.95;
    transition-property: opacity, translate, scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.perk-item:hover .perk-modal,
.perk-modal.open {
    opacity: 1;
    display: flex;
    translate: 0 0;
    scale: 1 1;
}

.perk-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(245, 158, 11, 0.35);
}

.perk-modal-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #FBBF24;
    letter-spacing: 0.5px;
    flex-grow: 1;
    white-space: normal;
}

.perk-modal-tag {
    font-size: 12px;
    -unity-font-style: bold;
    color: #34D399;
    background-color: rgba(52, 211, 153, 0.15);
    border-radius: 6px;
    padding: 3px 8px;
    margin-left: 8px;
}

.perk-modal-desc {
    font-size: 16px;
    color: #F8FAFC;
    white-space: normal;
    letter-spacing: 0.2px;
}

/* ==========================================================================
   VINHETA DE CORRUPÇÃO EM TELA CHEIA (DESATIVADA - VOLUME DA CÂMERA GERENCIA)
   ========================================================================== */

.vignette-corruption {
    display: none;
}

/* ==========================================================================
   HEADER DE DATA / CALENDÁRIO
   ========================================================================== */

.header-date-container {
    position: absolute;
    top: 24px;
    right: 32px;
    width: 216px;
    height: 216px;
    background-image: url('project://database/Assets/Sprites/calendario.png?fileID=21300000&guid=f8b071edf6fc0a342a4880adeaa7cd79&type=3#calendario');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    justify-content: center;
    align-items: center;
    padding-top: 45px;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.header-date-label {
    font-size: 40px;
    -unity-font-style: bold;
    color: #000000;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    margin-bottom: 0;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}
