<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False" picking-mode="Ignore">
    <Style src="Calendar.uss" />

    <!-- CONTAINER RAIZ DO CANVAS -->
    <ui:VisualElement name="calendar-root" class="calendar-root" picking-mode="Ignore">
        
        <!-- FOLHA DO CALENDÁRIO VERTICAL -->
        <ui:VisualElement name="calendar-page" class="calendar-page" picking-mode="Ignore">
                
                <!-- ESPIRAL / ANÉIS METÁLICOS DE ENCADERNAÇÃO NO TOPO -->
                <ui:VisualElement class="calendar-binder-bar" picking-mode="Ignore">
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="binder-hole" picking-mode="Ignore"><ui:VisualElement class="binder-ring" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>

                <!-- CABEÇALHO SUPERIOR: ANO NO CANTO, NAVEGAÇÃO DE ANOS E CHANCELARIA -->
                <ui:VisualElement class="calendar-header" picking-mode="Ignore">
                    
                    <!-- CANTO ESQUERDO: ANO GRANDE EM DESTAQUE -->
                    <ui:VisualElement class="year-corner-box" picking-mode="Ignore">
                        <ui:Label text="EXERCÍCIO" class="year-caption-label" picking-mode="Ignore" />
                        <ui:Label name="year-number" text="2026" class="calendar-giant-year" picking-mode="Ignore" />
                        <ui:Label text="OFICIAL" class="year-stamp-tag" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <!-- CENTRO: NOME DO ANO DO MANDATO E NAVEGAÇÃO ANUAL -->
                    <ui:VisualElement class="month-center-box" picking-mode="Ignore">
                        <ui:VisualElement class="year-title-row" picking-mode="Ignore">
                            <ui:Button name="btn-prev-year" text="◀" class="year-nav-btn" picking-mode="Position" />
                            <ui:Label name="year-title" text="1º ANO DO MANDATO" class="calendar-year-title" picking-mode="Ignore" />
                            <ui:Button name="btn-next-year" text="▶" class="year-nav-btn" picking-mode="Position" />
                        </ui:VisualElement>
                        <ui:Label name="year-subtitle" text="MESES 01 A 12 DE 48 • CRONOGRAMA ANUAL DO GOVERNO" class="calendar-year-subtitle" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <!-- CANTO DIREITO: BRASÃO / CHANCELARIA -->
                    <ui:VisualElement class="cabinet-seal-box" picking-mode="Ignore">
                        <ui:Label text="REPÚBLICA FEDERATIVA" class="cabinet-seal-title" picking-mode="Ignore" />
                        <ui:Label text="GABINETE PRESIDENCIAL" class="cabinet-seal-sub" picking-mode="Ignore" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- LINHA DIVISÓRIA DE TINTA TIPOGRÁFICA -->
                <ui:VisualElement class="calendar-divider-line" picking-mode="Ignore" />

                <!-- SEÇÃO 1: GRADE ANUAL COM OS 12 MESES DO ANO (3x4) -->
                <ui:VisualElement class="calendar-grid-section" picking-mode="Ignore">
                    
                    <ui:VisualElement name="months-grid" class="months-grid" picking-mode="Ignore">
                        
                        <!-- MÊS 01 (JANEIRO) -->
                        <ui:VisualElement name="month-card-1" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-1" text="01 JANEIRO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-1" text="MÊS 01" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-1" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 02 (FEVEREIRO) -->
                        <ui:VisualElement name="month-card-2" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-2" text="02 FEVEREIRO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-2" text="MÊS 02" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-2" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 03 (MARÇO) -->
                        <ui:VisualElement name="month-card-3" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-3" text="03 MARÇO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-3" text="MÊS 03" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-3" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 04 (ABRIL) -->
                        <ui:VisualElement name="month-card-4" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-4" text="04 ABRIL" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-4" text="MÊS 04" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-4" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 05 (MAIO) -->
                        <ui:VisualElement name="month-card-5" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-5" text="05 MAIO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-5" text="MÊS 05" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-5" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 06 (JUNHO) -->
                        <ui:VisualElement name="month-card-6" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-6" text="06 JUNHO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-6" text="MÊS 06" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-6" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 07 (JULHO) -->
                        <ui:VisualElement name="month-card-7" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-7" text="07 JULHO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-7" text="MÊS 07" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-7" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 08 (AGOSTO) -->
                        <ui:VisualElement name="month-card-8" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-8" text="08 AGOSTO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-8" text="MÊS 08" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-8" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 09 (SETEMBRO) -->
                        <ui:VisualElement name="month-card-9" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-9" text="09 SETEMBRO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-9" text="MÊS 09" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-9" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 10 (OUTUBRO) -->
                        <ui:VisualElement name="month-card-10" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-10" text="10 OUTUBRO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-10" text="MÊS 10" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-10" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 11 (NOVEMBRO) -->
                        <ui:VisualElement name="month-card-11" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-11" text="11 NOVEMBRO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-11" text="MÊS 11" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-11" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- MÊS 12 (DEZEMBRO) -->
                        <ui:VisualElement name="month-card-12" class="month-card" picking-mode="Position">
                            <ui:VisualElement class="month-card-header" picking-mode="Ignore">
                                <ui:Label name="month-card-title-12" text="12 DEZEMBRO" class="month-title-label" picking-mode="Ignore" />
                                <ui:Label name="month-card-tag-12" text="MÊS 12" class="month-tag-label" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="month-card-body-12" class="month-card-body" picking-mode="Ignore" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- LINHA DIVISÓRIA INFERIOR -->
                <ui:VisualElement class="calendar-divider-line" picking-mode="Ignore" />

                <!-- SEÇÃO 2 (VERTICAL INFERIOR): AGENDAMENTOS DO ANO E POST-IT DO GABINETE -->
                <ui:VisualElement class="calendar-bottom-section" picking-mode="Ignore">
                    
                    <!-- BLOCO DE AGENDAMENTOS DO ANO -->
                    <ui:VisualElement class="scheduled-panel" picking-mode="Ignore">
                        <ui:VisualElement class="scheduled-header-row" picking-mode="Ignore">
                            <ui:Label text="CRONOGRAMA &amp; EVENTOS DO ANO" class="scheduled-title" picking-mode="Ignore" />
                            <ui:Label text="AGENDAMENTOS" class="scheduled-tag" picking-mode="Ignore" />
                        </ui:VisualElement>
                        
                        <ui:ScrollView name="scheduled-events-list" class="scheduled-scroll" picking-mode="Ignore">
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- POST-IT AMARELO DE LEMBRETE DO GABINETE -->
                    <ui:VisualElement class="postit-box" picking-mode="Ignore">
                        <ui:VisualElement class="postit-pushpin" picking-mode="Ignore" />
                        <ui:Label text="Nota da Secretaria-Geral:" class="postit-title-label" picking-mode="Ignore" />
                        <ui:Label text="Passe o cursor sobre qualquer mês para revisar a proposta deliberada, ministro responsável e o impacto detalhado nos indicadores nacionais." class="postit-content-label" picking-mode="Ignore" />
                        <ui:Label text="— Gabinete da Presidência" class="postit-signature-label" picking-mode="Ignore" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- CAMADA DE OVERLAY DO TOOLTIP (ÚLTIMO ELEMENTO DE CALENDAR-PAGE = 100% SEMPRE NO TOPO DE TUDO) -->
                <ui:VisualElement name="calendar-tooltip-overlay" class="calendar-tooltip-overlay hidden" picking-mode="Ignore">
                    <ui:VisualElement name="calendar-tooltip-card" class="calendar-tooltip-card" picking-mode="Ignore">
                        
                        <!-- CABEÇALHO DO TOOLTIP: DATA E STATUS BADGE -->
                        <ui:VisualElement class="tooltip-header" picking-mode="Ignore">
                            <ui:Label name="tooltip-date-label" text="JANEIRO DE 2026" class="tooltip-date-label" picking-mode="Ignore" />
                            <ui:Label name="tooltip-status-tag" text="DESPACHADO: APROVADO" class="tooltip-status-tag tag-approved" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- BLOCO DE NPC COM FOTO 3X4 E CLIPE DE PAPEL -->
                        <ui:VisualElement name="tooltip-npc-section" class="tooltip-npc-block" picking-mode="Ignore">
                            <ui:VisualElement class="tooltip-portrait-frame" picking-mode="Ignore">
                                <ui:VisualElement class="paper-clip-deco" picking-mode="Ignore" />
                                <ui:VisualElement name="tooltip-portrait" class="tooltip-npc-portrait" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="tooltip-npc-info" picking-mode="Ignore">
                                <ui:Label name="tooltip-npc-name" text="Ministro da Economia" class="tooltip-npc-name" picking-mode="Ignore" />
                                <ui:Label name="tooltip-proposal-title" text="Diretrizes do Novo Mandato" class="tooltip-proposal-title" picking-mode="Ignore" />
                                <ui:Label name="tooltip-proposal-desc" text="Aprovação do pacote inicial de governabilidade." class="tooltip-proposal-desc" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- BLOCO DE ATRIBUTOS (+/- ÍNDICES NACIONAIS) -->
                        <ui:VisualElement name="tooltip-stats-section" class="tooltip-stats-row" picking-mode="Ignore">
                            <ui:Label name="tooltip-stat-1" text="+10 Popularidade" class="stat-pill stat-pill--pos" picking-mode="Ignore" />
                            <ui:Label name="tooltip-stat-2" text="+5 Estabilidade" class="stat-pill stat-pill--pos" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- BLOCO DE PERKS DESBLOQUEADOS -->
                        <ui:VisualElement name="tooltip-perk-section" class="tooltip-perk-row" picking-mode="Ignore">
                            <ui:Label name="tooltip-perk-text" text="★ Perk: Lua de Mel Política" class="tooltip-perk-text" picking-mode="Ignore" />
                        </ui:VisualElement>

                        <!-- BLOCO DE EVENTO FUTURO (CRISES, DIPLOMACIA, ETC.) -->
                        <ui:VisualElement name="tooltip-event-section" class="tooltip-event-block hidden" picking-mode="Ignore">
                            <ui:Label name="tooltip-event-title" text="Título do Evento" class="tooltip-event-title" picking-mode="Ignore" />
                            <ui:Label name="tooltip-event-desc" text="Descrição detalhada do acontecimento futuro..." class="tooltip-event-desc" picking-mode="Ignore" />
                            <ui:Label name="tooltip-event-impact" text="Impacto previsto nos indicadores nacionais." class="tooltip-event-impact" picking-mode="Ignore" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
