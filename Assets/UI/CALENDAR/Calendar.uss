/* ==========================================================================
   CALENDÁRIO DE PAPEL VERTICAL PRESIDENCIAL — PROJETO MANDATO
   Design Anual por Meses (12 Meses por Ano do Mandato).
   Navegação anual por setas (◀ 1º ANO ▶ .. 4º ANO).
   Tipografia grande, carimbos expressivos, espaçamento generoso e hover diegético.
   ========================================================================== */

:root {
    width: 100%;
    height: 100%;
    background-color: transparent;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -unity-font: url('project://database/Assets/BreeSerif-Regular.ttf?fileID=12800000&guid=59b91adeaaa5b7741a8f1ac398008a07&type=3#BreeSerif-Regular');
    -unity-font-definition: url('project://database/Assets/BreeSerif-Regular.ttf?fileID=12800000&guid=59b91adeaaa5b7741a8f1ac398008a07&type=3#BreeSerif-Regular');
}

/* CONTAINER RAIZ DO CANVAS */
.calendar-root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    margin: 0;
    padding: 0;
}

/* FOLHA DO CALENDÁRIO VERTICAL (OCUPA 100% DO PAINEL) */
.calendar-page {
    width: 100%;
    height: 100%;
    background-color: #FAF5EA; /* Bege pergaminho oficial */
    border-width: 4px;
    border-color: #3E3022;
    border-radius: 12px;
    padding: 24px 28px 22px 28px;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
}

/* --------------------------------------------------------------------------
   ESPIRAL / ANÉIS METÁLICOS DE ENCADERNAÇÃO NO TOPO
   -------------------------------------------------------------------------- */
.calendar-binder-bar {
    width: 92%;
    height: 28px;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    margin-bottom: -10px;
    align-self: center;
    z-index: 10;
}

.binder-hole {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: #2B2117;
    border-width: 2px;
    border-color: #17110B;
    justify-content: center;
    align-items: center;
}

.binder-ring {
    width: 10px;
    height: 28px;
    border-radius: 5px;
    background-color: #695642;
    border-width: 2px;
    border-color: #3D3022;
    margin-top: -5px;
}

/* --------------------------------------------------------------------------
   CABEÇALHO SUPERIOR: ANO NO CANTO, NAVEGAÇÃO ANUAL E CHANCELARIA
   -------------------------------------------------------------------------- */
.calendar-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
}

/* CANTO ESQUERDO: ANO GRANDE EM DESTAQUE */
.year-corner-box {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border-right-width: 2.5px;
    border-right-color: #5C4A38;
    padding-right: 18px;
}

.year-caption-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #6E5B49;
    letter-spacing: 2px;
}

.calendar-giant-year {
    font-size: 58px;
    -unity-font-style: bold;
    color: #17110A; /* Tinta tipográfica preta oficial */
    line-height: 54px;
    letter-spacing: 2px;
    margin-top: -2px;
    margin-bottom: -4px;
}

.year-stamp-tag {
    font-size: 12px;
    -unity-font-style: bold;
    color: #8C2424; /* Vermelho carimbo oficial */
    letter-spacing: 3px;
}

/* CENTRO: NOME DO ANO DO MANDATO E NAVEGAÇÃO ANUAL */
.month-center-box {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.year-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.year-nav-btn {
    width: 44px;
    height: 44px;
    border-width: 2.5px;
    border-color: #5C4A38;
    border-radius: 8px;
    background-color: #EDE2CD;
    color: #3B2E21;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 12px;
    margin-right: 12px;
    transition-duration: 0.12s;
}

.year-nav-btn:hover,
.year-nav-btn.hovered {
    background-color: #DCCBB1;
    border-color: #2D2217;
    scale: 1.08;
}

.calendar-year-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: #1F1710;
    letter-spacing: 3px;
}

.calendar-year-subtitle {
    font-size: 13px;
    -unity-font-style: bold;
    color: #7A6652;
    letter-spacing: 1.5px;
    margin-top: 4px;
}

/* CANTO DIREITO: BRASÃO / CHANCELARIA */
.cabinet-seal-box {
    border-width: 2.5px;
    border-color: #8C7B68;
    border-radius: 6px;
    padding: 8px 16px;
    align-items: center;
    justify-content: center;
    background-color: rgba(140, 123, 104, 0.08);
}

.cabinet-seal-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #5C4C3C;
    letter-spacing: 2px;
}

.cabinet-seal-sub {
    font-size: 11px;
    color: #7A6856;
    letter-spacing: 1px;
    margin-top: 2px;
}

/* LINHA SEPARADORA RÚSTICA */
.calendar-divider-line {
    width: 100%;
    height: 3px;
    background-color: #4A3A2A;
    margin-top: 6px;
    margin-bottom: 10px;
}

/* --------------------------------------------------------------------------
   SEÇÃO 1: GRADE ANUAL COM OS 12 MESES DO ANO (3 COLUNAS x 4 LINHAS)
   -------------------------------------------------------------------------- */
.calendar-grid-section {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}

.months-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
    width: 100%;
}

/* CARD INDIVIDUAL DO MÊS */
.month-card {
    width: 32%;
    height: 172px;
    background-color: #FDFBF6;
    border-width: 2.5px;
    border-color: #C8BAA3;
    border-radius: 8px;
    padding: 10px 12px;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    transition-duration: 0.12s;
    margin-bottom: 10px;
}

.month-card:hover,
.month-card.hovered {
    border-color: #94301B;
    background-color: #FFFDF9;
    scale: 1.03;
    z-index: 50;
}

/* CABEÇALHO DO CARD DO MÊS */
.month-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1.5px;
    border-bottom-color: #DDD0BC;
    padding-bottom: 6px;
    margin-bottom: 4px;
}

.month-title-label {
    font-size: 19px;
    -unity-font-style: bold;
    color: #23190F;
    letter-spacing: 1px;
}

.month-tag-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #8C7B68;
    letter-spacing: 1px;
    background-color: rgba(140, 123, 104, 0.12);
    padding: 2px 7px;
    border-radius: 4px;
}

/* CORPO DO CARD DO MÊS */
.month-card-body {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 4px 2px;
}

/* --------------------------------------------------------------------------
   ESTADOS VISUAIS DOS CARDS DE MÊS
   -------------------------------------------------------------------------- */

/* ESTADO 1: MÊS PASSADO (COM CARIMBO OFICIAL DE DECISÃO/EVENTO) */
.month-card--past {
    background-color: #F8F3E8;
}

.month-stamp {
    border-width: 3px;
    border-radius: 6px;
    padding: 4px 12px;
    margin-bottom: 6px;
    rotate: -4deg;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.month-stamp-label {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.stamp-approved {
    border-color: #2E7D32;
    background-color: rgba(46, 125, 50, 0.10);
}
.stamp-approved .month-stamp-label {
    color: #2E7D32;
}

.stamp-rejected {
    border-color: #C62828;
    background-color: rgba(198, 40, 40, 0.10);
    rotate: 4deg;
}
.stamp-rejected .month-stamp-label {
    color: #C62828;
}

.stamp-event {
    border-color: #1565C0;
    background-color: rgba(21, 101, 192, 0.10);
}
.stamp-event .month-stamp-label {
    color: #1565C0;
}

.month-card-decision-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #3E3022;
    -unity-text-align: middle-center;
    white-space: normal;
    max-height: 38px;
    overflow: hidden;
}

.month-card-decision-sub {
    font-size: 11px;
    color: #7A6652;
    -unity-text-align: middle-center;
    margin-top: 2px;
    white-space: normal;
}

/* ESTADO 2: MÊS ATUAL (DESTAQUE DA PAUTA PRESIDENCIAL EM ANDAMENTO) */
.month-card--current {
    background-color: #FFF9F0;
    border-color: #B71C1C;
    border-width: 3px;
}

.month-card--current .month-title-label {
    color: #B71C1C;
}

.month-card--current .month-tag-label {
    color: #FFFFFF;
    background-color: #B71C1C;
}

.current-month-badge {
    background-color: #B71C1C;
    border-radius: 4px;
    padding: 3px 10px;
    margin-bottom: 6px;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.current-month-badge-label {
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
}

.current-proposal-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #17110A;
    -unity-text-align: middle-center;
    white-space: normal;
    max-height: 42px;
    overflow: hidden;
}

.current-proposal-sub {
    font-size: 11px;
    -unity-font-style: bold;
    color: #C65807;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ESTADO 3: MÊS FUTURO (AGENDA ABERTA OU EVENTO AGENDADO) */
.month-card--future {
    background-color: #FCFAF5;
    opacity: 0.92;
}

.month-card--event {
    border-color: #1565C0;
    background-color: #F8FBFE;
}

.future-event-badge {
    background-color: rgba(21, 101, 192, 0.14);
    border-width: 1.5px;
    border-color: #1565C0;
    border-radius: 4px;
    padding: 4px 10px;
    margin-bottom: 5px;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.future-event-badge-label {
    color: #1565C0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.future-event-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #1F1710;
    -unity-text-align: middle-center;
    white-space: normal;
    max-height: 38px;
    overflow: hidden;
}

.future-open-agenda {
    font-size: 13px;
    color: #8C7B68;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
}

.future-open-sub {
    font-size: 11px;
    color: #A89B8C;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* --------------------------------------------------------------------------
   HOVER POPUP: CAMADA DE OVERLAY TOPMOST E CARD DE DOSSIÊ DO MÊS
   -------------------------------------------------------------------------- */
.calendar-tooltip-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: visible;
    pointer-events: none;
}

.calendar-tooltip-card {
    position: absolute;
    width: 350px;
    background-color: #FAF5EA;
    border-width: 3px;
    border-color: #4A3A2C;
    border-radius: 8px;
    padding: 16px 18px;
    box-sizing: border-box;
    flex-direction: column;
}

.hidden {
    display: none;
}

.tooltip-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: #8C7A65;
    padding-bottom: 8px;
    margin-bottom: 12px;
}

.tooltip-date-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: #2A1E14;
    letter-spacing: 1px;
}

.tooltip-status-tag {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 3px 9px;
    border-radius: 4px;
}

.tag-approved {
    background-color: rgba(46, 125, 50, 0.16);
    border-width: 1px;
    border-color: #2E7D32;
    color: #2E7D32;
}

.tag-rejected {
    background-color: rgba(183, 28, 28, 0.16);
    border-width: 1px;
    border-color: #B71C1C;
    color: #B71C1C;
}

.tag-today {
    background-color: rgba(198, 88, 7, 0.16);
    border-width: 1px;
    border-color: #C65807;
    color: #C65807;
}

.tag-diplomacy {
    background-color: rgba(21, 101, 192, 0.2);
    border-width: 1px;
    border-color: #1565C0;
    color: #1565C0;
}

/* BLOCO DO NPC */
.tooltip-npc-block {
    flex-direction: row;
    margin-bottom: 12px;
}

.tooltip-portrait-frame {
    width: 62px;
    height: 74px;
    border-width: 2px;
    border-color: #4A3A2C;
    background-color: #E2D7C3;
    margin-right: 14px;
    position: relative;
    border-radius: 4px;
}

.paper-clip-deco {
    position: absolute;
    left: 8px;
    top: -6px;
    width: 10px;
    height: 18px;
    border-width: 2px;
    border-color: #73614E;
    border-radius: 5px;
    background-color: #C2B4A1;
}

.tooltip-npc-portrait {
    width: 100%;
    height: 100%;
    background-color: #C8BAA3;
}

.tooltip-npc-info {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.tooltip-npc-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #614B37;
}

.tooltip-proposal-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #1F160E;
    margin-top: 2px;
    white-space: normal;
}

.tooltip-proposal-desc {
    font-size: 12px;
    color: #524030;
    margin-top: 2px;
    white-space: normal;
}

/* ATRIBUTOS */
.tooltip-stats-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
}

.stat-pill {
    font-size: 12px;
    -unity-font-style: bold;
    padding: 3px 8px;
    border-radius: 4px;
}

.stat-pill--pos {
    background-color: #E8F5E9;
    color: #1B5E20;
    border-width: 1px;
    border-color: #81C784;
}

.stat-pill--neg {
    background-color: #FFEBEE;
    color: #B71C1C;
    border-width: 1px;
    border-color: #E57373;
}

/* PERKS */
.tooltip-perk-row {
    background-color: #FFF8E1;
    border-width: 1px;
    border-color: #FFE082;
    border-radius: 4px;
    padding: 5px 10px;
}

.tooltip-perk-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: #825807;
}

/* TEXTOS DE EVENTO FUTURO NO TOOLTIP */
.tooltip-event-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #1C150D;
    margin-bottom: 5px;
    white-space: normal;
}

.tooltip-event-desc {
    font-size: 12px;
    color: #4A3A2C;
    margin-bottom: 5px;
    white-space: normal;
}

.tooltip-event-impact {
    font-size: 12px;
    -unity-font-style: bold;
    color: #8C2424;
    white-space: normal;
}

/* --------------------------------------------------------------------------
   SEÇÃO INFERIOR VERTICAL: AGENDAMENTOS DO ANO + POST-IT
   -------------------------------------------------------------------------- */
.calendar-bottom-section {
    height: 340px;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

/* PAINEL DE AGENDAMENTOS DO ANO */
.scheduled-panel {
    width: 63%;
    background-color: #F7F1E4;
    border-width: 2.5px;
    border-color: #4A3A2C;
    border-radius: 8px;
    padding: 12px 14px;
    flex-direction: column;
}

.scheduled-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: #8C7A65;
    padding-bottom: 6px;
    margin-bottom: 8px;
}

.scheduled-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #2D2115;
    letter-spacing: 1px;
}

.scheduled-tag {
    font-size: 11px;
    -unity-font-style: bold;
    color: #8C2424;
    letter-spacing: 1.5px;
}

.scheduled-scroll {
    flex-grow: 1;
}

/* ITENS DO CRONOGRAMA */
.schedule-item {
    flex-direction: row;
    background-color: #FDFBF6;
    border-width: 1.5px;
    border-color: #C8BAA3;
    border-left-width: 5px;
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 8px;
}

.item--crisis { border-left-color: #B71C1C; }
.item--diplomacy { border-left-color: #1565C0; }
.item--deadline { border-left-color: #C65807; }
.item--congress { border-left-color: #2E7D32; }

.schedule-date-col {
    width: 55px;
    align-items: center;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: #DDD0BC;
    padding-right: 8px;
    margin-right: 10px;
}

.schedule-day-txt {
    font-size: 18px;
    -unity-font-style: bold;
    color: #23190F;
}

.schedule-mon-txt {
    font-size: 11px;
    -unity-font-style: bold;
    color: #7D6B58;
}

.schedule-info-col {
    flex-grow: 1;
    flex-direction: column;
}

.schedule-badge-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.badge-pill {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 3px;
}

.badge-crisis { background-color: #FFEBEE; color: #B71C1C; }
.badge-diplomacy { background-color: #E3F2FD; color: #1565C0; }
.badge-deadline { background-color: #FFF3E0; color: #C65807; }
.badge-congress { background-color: #E8F5E9; color: #2E7D32; }

.badge-time {
    font-size: 10px;
    -unity-font-style: bold;
    color: #8C7B68;
}

.schedule-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #1F1710;
    white-space: normal;
}

.schedule-details {
    font-size: 11px;
    color: #544434;
    white-space: normal;
}

/* --------------------------------------------------------------------------
   POST-IT AMARELO DE ANOTAÇÃO DO GABINETE
   -------------------------------------------------------------------------- */
.postit-box {
    width: 34%;
    background-color: #FFF7B2;
    border-width: 1px;
    border-color: #D6CA74;
    border-radius: 4px;
    padding: 14px 16px;
    position: relative;
    rotate: -1.5deg;
    justify-content: space-between;
}

.postit-pushpin {
    position: absolute;
    top: 6px;
    left: 50%;
    margin-left: -5px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #C62828;
    border-width: 1.5px;
    border-color: #8A1515;
}

.postit-title-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #5C5212;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.postit-content-label {
    font-size: 12px;
    color: #383207;
    white-space: normal;
    line-height: 16px;
}

.postit-signature-label {
    -unity-font: url('project://database/Assets/Brother%20Signature.otf?fileID=12800000&guid=5e6a9f7a8b4c3d2e1f0a9b8c7d6e5f4a&type=3#Brother Signature');
    -unity-font-definition: url('project://database/Assets/Brother%20Signature.otf?fileID=12800000&guid=5e6a9f7a8b4c3d2e1f0a9b8c7d6e5f4a&type=3#Brother Signature');
    font-size: 22px;
    color: #172D4D; /* Tinta azul caneta tinteiro */
    margin-top: 4px;
    -unity-text-align: middle-right;
}
