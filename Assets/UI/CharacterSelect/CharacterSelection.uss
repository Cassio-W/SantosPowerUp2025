:root {
    -unity-font: url("project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH");
    -unity-font-definition: url("project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH");
    width: 100%;
    height: 100%;
    background-color: rgb(234, 236, 239);
    padding: 10px 12px;
    box-sizing: border-box;
}

.screen-root {
    width: 100%;
    height: 100%;
    background-color: rgb(234, 236, 239);
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    flex-direction: column;
}

Label {
    -unity-font: url("project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH");
    -unity-font-definition: url("project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH");
    margin: 0;
    padding: 0;
}

.top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(255, 255, 255);
    height: 54px;
    min-height: 54px;
    flex-shrink: 0;
    border-top-width: 3px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 3px;
    border-top-color: rgb(31, 78, 121);
    border-left-color: rgb(184, 184, 184);
    border-right-color: rgb(112, 112, 112);
    border-bottom-color: rgb(68, 68, 68);
    padding: 0 16px;
    margin-bottom: 10px;
}

.header-left-box {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.status-led {
    width: 12px;
    height: 12px;
    background-color: rgb(22, 163, 74);
    margin-right: 14px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(134, 239, 172);
    border-left-color: rgb(134, 239, 172);
    border-right-color: rgb(20, 83, 45);
    border-bottom-color: rgb(20, 83, 45);
}

.header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    letter-spacing: 1.5px;
    flex-grow: 1;
}

.counter-chip {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(31, 78, 121);
    padding: 6px 16px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(45, 104, 156);
    border-left-color: rgb(45, 104, 156);
    border-right-color: rgb(14, 41, 64);
    border-bottom-color: rgb(14, 41, 64);
}

.main-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-between;
    overflow: hidden;
}

.carousel-column {
    width: 19%;
    height: 100%;
    background-color: rgb(241, 245, 249);
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-color: rgb(203, 213, 225);
    border-left-color: rgb(203, 213, 225);
    border-right-color: rgb(148, 163, 184);
    border-bottom-color: rgb(148, 163, 184);
    padding: 14px;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    align-items: stretch;
}

.column-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(30, 58, 138);
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(37, 99, 235);
    padding-bottom: 6px;
    flex-shrink: 0;
}

.carousel-slot {
    flex-direction: column;
    align-items: center;
    border-radius: 0;
    transition-property: opacity, background-color, border-color;
    transition-duration: 0.12s;
    align-self: center;
    align-content: flex-start;
    flex-wrap: nowrap;
    flex-shrink: 1;
    justify-content: center;
}

.slot-side {
    opacity: 0.55;
    background-color: rgb(226, 232, 240);
    height: 20%;
    min-height: 80px;
    padding: 8px 12px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(203, 213, 225);
    border-left-color: rgb(203, 213, 225);
    border-right-color: rgb(148, 163, 184);
    border-bottom-color: rgb(148, 163, 184);
    aspect-ratio: 1;
}

.slot-active {
    opacity: 1;
    background-color: rgb(255, 255, 255);
    height: 26%;
    min-height: 175px;
    padding: 14px;
    margin-top: 6px;
    margin-bottom: 6px;
    border-top-width: 2px;
    border-left-width: 4px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-color: rgb(31, 78, 121);
    border-left-color: rgb(37, 99, 235);
    border-right-color: rgb(18, 52, 82);
    border-bottom-color: rgb(18, 52, 82);
    justify-content: center;
    align-self: center;
    align-items: center;
    align-content: flex-start;
}

.slot-portrait {
    background-color: rgb(209, 213, 219);
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 0;
    flex-shrink: 0;
    margin-left: 0;
    margin-bottom: 14px;
}

.slot-portrait-small {
    width: 54px;
    height: 54px;
    border-width: 2px;
    border-top-color: rgb(203, 213, 225);
    border-left-color: rgb(203, 213, 225);
    border-right-color: rgb(148, 163, 184);
    border-bottom-color: rgb(148, 163, 184);
}

.slot-portrait-large {
    width: 96px;
    height: 96px;
    border-width: 3px;
    border-top-color: rgb(37, 99, 235);
    border-left-color: rgb(37, 99, 235);
    border-right-color: rgb(30, 64, 175);
    border-bottom-color: rgb(30, 64, 175);
}

.active-slot-info {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.slot-name {
    color: rgb(30, 41, 59);
    white-space: normal;
    -unity-text-align: middle-center;
}

.slot-name-small {
    font-size: 15px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.slot-name-large {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    letter-spacing: 0.5px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.active-badge {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(22, 163, 74);
    background-color: rgb(220, 252, 231);
    border-width: 1px;
    border-color: rgb(134, 239, 172);
    padding: 3px 8px;
    letter-spacing: 1.5px;
    margin-top: 6px;
    align-self: center;
    align-items: stretch;
    justify-content: flex-start;
}

.detail-column {
    width: 66%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-color: rgb(203, 213, 225);
    border-left-color: rgb(203, 213, 225);
    border-right-color: rgb(148, 163, 184);
    border-bottom-color: rgb(148, 163, 184);
    padding: 18px 22px;
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
}

.detail-header-card {
    border-bottom-width: 3px;
    border-bottom-color: rgb(31, 78, 121);
    padding-bottom: 8px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.detail-name-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    letter-spacing: 0.8px;
    white-space: normal;
}

.detail-title-label {
    font-size: 16px;
    color: rgb(180, 83, 9);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-top: 4px;
    white-space: normal;
}

.detail-content-row {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-between;
    overflow: hidden;
}

.detail-portrait-box {
    width: 40%;
    height: 100%;
    background-color: rgb(241, 245, 249);
    border-top-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-color: rgb(203, 213, 225);
    border-left-color: rgb(203, 213, 225);
    border-right-color: rgb(148, 163, 184);
    border-bottom-color: rgb(148, 163, 184);
    padding: 5px;
    margin-right: 18px;
    flex-shrink: 0;
}

.detail-portrait-img {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.detail-text-box {
    width: 60%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
}

.section-subtitle {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(30, 58, 138);
    letter-spacing: 1px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.detail-bio-label {
    font-size: 15px;
    color: rgb(51, 65, 85);
    white-space: normal;
    margin-bottom: 10px;
    flex-shrink: 1;
    overflow: hidden;
}

.stats-container {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: auto;
    padding-top: 10px;
    border-top-width: 2px;
    border-top-color: rgb(226, 232, 240);
}

.stats-workspace {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 6px;
    align-items: stretch;
}

.stats-grid-container {
    width: 74%;
    flex-direction: column;
    justify-content: space-between;
}

.stats-grid-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    margin-bottom: 6px;
}

.stat-chip {
    width: 46%;
    min-height: 85px;
    padding: 0;
    align-items: center;
    justify-content: flex-end;
    background-color: rgb(248, 250, 252);
    border-top-width: 3px;
    border-left-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(226, 232, 240);
    border-right-color: rgb(203, 213, 225);
    border-bottom-color: rgb(203, 213, 225);
    flex-direction: column;
    flex-wrap: nowrap;
    height: 165px;
    margin-top: 12px;
    margin-right: 15px;
    position: relative;
    overflow: hidden;
}

.stat-chip-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
}

.fill-climate-bg {
    background-color: rgba(34, 197, 94, 0.28);
    border-top-width: 3px;
    border-top-color: rgb(22, 163, 74);
}

.fill-economy-bg {
    background-color: rgba(234, 179, 8, 0.28);
    border-top-width: 3px;
    border-top-color: rgb(202, 138, 4);
}

.fill-relations-bg {
    background-color: rgba(56, 189, 248, 0.28);
    border-top-width: 3px;
    border-top-color: rgb(2, 132, 199);
}

.fill-people-bg {
    background-color: rgba(244, 114, 182, 0.28);
    border-top-width: 3px;
    border-top-color: rgb(219, 39, 119);
}

.stat-chip-foreground {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 10px 6px;
}

.stat-chip-tag {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    align-items: stretch;
    align-self: auto;
}

.stat-chip-val {
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    justify-content: flex-start;
    align-items: stretch;
}

.stat-chip-body {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
}

.stat-chip-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 15px;
}

.chip-climate {
    background-color: rgb(240, 253, 244);
    border-top-color: rgb(22, 163, 74);
}

.chip-climate .stat-chip-tag {
    color: rgb(21, 128, 61);
}

.chip-climate .stat-chip-icon {
    -unity-background-image-tint-color: rgb(22, 163, 74);
}

.chip-climate .stat-chip-val {
    color: rgb(22, 163, 74);
}

.chip-economy {
    background-color: rgb(254, 252, 232);
    border-top-color: rgb(202, 138, 4);
}

.chip-economy .stat-chip-tag {
    color: rgb(133, 77, 14);
}

.chip-economy .stat-chip-icon {
    -unity-background-image-tint-color: rgb(202, 138, 4);
}

.chip-economy .stat-chip-val {
    color: rgb(202, 138, 4);
}

.chip-relations {
    background-color: rgb(240, 249, 255);
    border-top-color: rgb(2, 132, 199);
}

.chip-relations .stat-chip-tag {
    color: rgb(3, 105, 161);
}

.chip-relations .stat-chip-icon {
    -unity-background-image-tint-color: rgb(2, 132, 199);
}

.chip-relations .stat-chip-val {
    color: rgb(2, 132, 199);
}

.chip-people {
    background-color: rgb(253, 242, 248);
    border-top-color: rgb(219, 39, 119);
}

.chip-people .stat-chip-tag {
    color: rgb(157, 23, 77);
}

.chip-people .stat-chip-icon {
    -unity-background-image-tint-color: rgb(219, 39, 119);
}

.chip-people .stat-chip-val {
    color: rgb(219, 39, 119);
}

.stat-corruption-pillar {
    width: 23.5%;
    position: relative;
    background-color: rgb(254, 242, 242);
    border-top-width: 3px;
    border-left-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(220, 38, 38);
    border-left-color: rgb(254, 202, 202);
    border-right-color: rgb(239, 68, 68);
    border-bottom-color: rgb(239, 68, 68);
    overflow: hidden;
    justify-content: flex-end;
    margin-bottom: 6px;
}

.stat-corruption-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(239, 68, 68, 0.32);
    border-top-width: 3px;
    border-top-color: rgb(220, 38, 38);
}

.stat-corruption-foreground {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 6px 4px;
}

.stat-corruption-tag {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(185, 28, 28);
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
}

.stat-corruption-icon {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(220, 38, 38);
    margin: 2px 0;
}

.stat-corruption-val {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(220, 38, 38);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
