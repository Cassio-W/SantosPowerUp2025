<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PC/RetroMonitor.uss?fileID=7433441132597879392&amp;guid=47a98b11c430489aa2ef80275819d45a&amp;type=3#RetroMonitor"/>
    <ui:VisualElement name="screen-root" picking-mode="Ignore" class="screen-root">
        <ui:VisualElement picking-mode="Ignore" class="top-compact-bar">
            <ui:VisualElement picking-mode="Ignore" class="system-tag-box">
                <ui:VisualElement picking-mode="Ignore" class="system-status-led"/>
                <ui:Label text="MANDATO" picking-mode="Ignore" class="system-compact-title"/>
            </ui:VisualElement>
            <ui:VisualElement name="pc-tabs-container" picking-mode="Ignore" class="pc-tabs-container hidden">
                <ui:Button name="btn-tab-gov" text="GOVERNO" picking-mode="Position" class="pc-tab-btn active-tab"/>
                <ui:Button name="btn-tab-war" text="GUERRA" picking-mode="Position" class="pc-tab-btn pc-tab-war"/>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="system-top-right-box">
                <ui:Label name="date-label" text="01/2025" picking-mode="Ignore" class="date-compact-chip"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="main-workspace" picking-mode="Ignore" class="main-workspace">
            <ui:VisualElement name="apps-grid-container" picking-mode="Ignore" class="apps-grid-container">
                <ui:VisualElement picking-mode="Ignore" class="cards-row">
                    <ui:VisualElement name="app-nature" picking-mode="Position" class="giant-card card-nature">
                        <ui:VisualElement name="fill-nature" picking-mode="Ignore" class="card-bg-fill fill-nature-bg" style="height: 50%;"/>
                        <ui:VisualElement name="ghost-fill-nature" picking-mode="Ignore" class="ghost-fill ghost-nature" style="height: 50%; opacity: 0;"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-foreground">
                            <ui:VisualElement name="icon-nature" picking-mode="Ignore" class="giant-icon" style="background-image: url(&quot;project://database/Assets/Sprites/Treenew.png?fileID=21300000&amp;guid=982e87e4a34157f4eb9258069f8f341d&amp;type=3#Treenew&quot;);"/>
                            <ui:Label name="value-nature" text="50%" picking-mode="Ignore" class="giant-value"/>
                        </ui:VisualElement>
                        <ui:Label name="arrow-nature" text="" picking-mode="Ignore" class="attr-arrow"/>
                        <ui:VisualElement name="dead-overlay-nature" picking-mode="Ignore" class="dead-overlay hidden">
                            <ui:Label text="X" picking-mode="Ignore" class="dead-x-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="app-economy" picking-mode="Position" class="giant-card card-economy">
                        <ui:VisualElement name="fill-economy" picking-mode="Ignore" class="card-bg-fill fill-economy-bg" style="height: 50%;"/>
                        <ui:VisualElement name="ghost-fill-economy" picking-mode="Ignore" class="ghost-fill ghost-economy" style="height: 50%; opacity: 0;"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-foreground">
                            <ui:VisualElement name="icon-economy" picking-mode="Ignore" class="giant-icon" style="background-image: url(&quot;project://database/Assets/Sprites/moneynew.png?fileID=21300000&amp;guid=1ff9b9ecfbad1924eb51f51a6f3863ec&amp;type=3#moneynew&quot;);"/>
                            <ui:Label name="value-economy" text="50%" picking-mode="Ignore" class="giant-value"/>
                        </ui:VisualElement>
                        <ui:Label name="arrow-economy" text="" picking-mode="Ignore" class="attr-arrow"/>
                        <ui:VisualElement name="dead-overlay-economy" picking-mode="Ignore" class="dead-overlay hidden">
                            <ui:Label text="X" picking-mode="Ignore" class="dead-x-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="cards-row">
                    <ui:VisualElement name="app-relations" picking-mode="Position" class="giant-card card-relations">
                        <ui:VisualElement name="fill-relations" picking-mode="Ignore" class="card-bg-fill fill-relations-bg" style="height: 50%;"/>
                        <ui:VisualElement name="ghost-fill-relations" picking-mode="Ignore" class="ghost-fill ghost-relations" style="height: 50%; opacity: 0;"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-foreground">
                            <ui:VisualElement name="icon-relations" picking-mode="Ignore" class="giant-icon" style="background-image: url(&quot;project://database/Assets/Sprites/peaceSlider.png?fileID=21300000&amp;guid=7de11bbadd901af438bbd94d6f311438&amp;type=3#peaceSlider&quot;);"/>
                            <ui:Label name="value-relations" text="50%" picking-mode="Ignore" class="giant-value"/>
                        </ui:VisualElement>
                        <ui:Label name="arrow-relations" text="" picking-mode="Ignore" class="attr-arrow"/>
                        <ui:VisualElement name="dead-overlay-relations" picking-mode="Ignore" class="dead-overlay hidden">
                            <ui:Label text="X" picking-mode="Ignore" class="dead-x-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="app-people" picking-mode="Position" class="giant-card card-people">
                        <ui:VisualElement name="fill-people" picking-mode="Ignore" class="card-bg-fill fill-people-bg" style="height: 50%;"/>
                        <ui:VisualElement name="ghost-fill-people" picking-mode="Ignore" class="ghost-fill ghost-people" style="height: 50%; opacity: 0;"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-foreground">
                            <ui:VisualElement name="icon-people" picking-mode="Ignore" class="giant-icon" style="background-image: url(&quot;project://database/Assets/Sprites/peopleSlider.png?fileID=21300000&amp;guid=f498b99f7dc683646b439a837578e287&amp;type=3#peopleSlider&quot;);"/>
                            <ui:Label name="value-people" text="50%" picking-mode="Ignore" class="giant-value"/>
                        </ui:VisualElement>
                        <ui:Label name="arrow-people" text="" picking-mode="Ignore" class="attr-arrow"/>
                        <ui:VisualElement name="dead-overlay-people" picking-mode="Ignore" class="dead-overlay hidden">
                            <ui:Label text="X" picking-mode="Ignore" class="dead-x-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="corruption-pillar" picking-mode="Position" class="giant-corruption-pillar">
                <ui:VisualElement name="fill-corruption" picking-mode="Ignore" class="corruption-bg-fill" style="height: 0%;"/>
                <ui:VisualElement name="ghost-fill-corruption" picking-mode="Ignore" class="ghost-fill ghost-corruption" style="height: 0%; opacity: 0;"/>
                <ui:VisualElement picking-mode="Ignore" class="corruption-foreground">
                    <ui:Label name="value-corruption" text="0%" picking-mode="Ignore" class="giant-corruption-value"/>
                    <ui:VisualElement picking-mode="Ignore" class="corruption-center-box">
                        <ui:VisualElement name="icon-corruption" picking-mode="Ignore" class="giant-corruption-icon" style="background-image: url(&quot;project://database/Assets/Sprites/corrupcao.png?fileID=21300000&amp;guid=f217d777a72a37b48880da6bf990a435&amp;type=3#corrupcao&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="arrow-corruption" text="" picking-mode="Ignore" class="attr-arrow"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="war-workspace" picking-mode="Ignore" class="war-workspace hidden">
            <ui:VisualElement name="war-general-panel" picking-mode="Ignore" class="war-general-panel">
                <ui:VisualElement picking-mode="Ignore" class="war-hero-readout-row">
                    <ui:VisualElement picking-mode="Ignore" class="war-side-box war-side-player">
                        <ui:Label name="war-pc-player-name" text="BRASIL" picking-mode="Ignore" class="war-side-label war-label-player"/>
                        <ui:Label name="war-pc-player-percent" text="50%" picking-mode="Ignore" class="war-giant-percent war-percent-player"/>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="war-center-status-box">
                        <ui:Label text="VS" picking-mode="Ignore" class="war-vs-badge"/>
                        <ui:Button name="btn-war-surrender-pc" text="RENDER-SE" picking-mode="Position" class="war-surrender-pc-btn hidden"/>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="war-side-box war-side-enemy">
                        <ui:Label name="war-pc-enemy-percent" text="50%" picking-mode="Ignore" class="war-giant-percent war-percent-enemy"/>
                        <ui:Label name="war-pc-enemy-name" text="INIMIGO" picking-mode="Ignore" class="war-side-label war-label-enemy"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="war-pc-bar-track" picking-mode="Ignore" class="war-pc-bar-track">
                    <ui:VisualElement name="war-pc-player-fill" picking-mode="Ignore" class="war-pc-player-fill" style="width: 50%;"/>
                    <ui:VisualElement name="war-pc-bar-divider" picking-mode="Ignore" class="war-pc-bar-divider"/>
                    <ui:VisualElement name="war-pc-enemy-fill" picking-mode="Ignore" class="war-pc-enemy-fill" style="width: 50%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="war-lower-area" picking-mode="Ignore" class="war-lower-area">
                <ui:VisualElement name="war-attributes-column" picking-mode="Ignore" class="war-attributes-column">
                    <ui:VisualElement name="war-row-tech" picking-mode="Ignore" class="war-attr-row">
                        <ui:VisualElement name="icon-war-tech" picking-mode="Ignore" class="war-attr-icon war-icon-tech"/>
                        <ui:VisualElement name="war-bar-tech" picking-mode="Ignore" class="war-level-bar">
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-1">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-1"/>
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-2">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-2"/>
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-3">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-3"/>
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-4">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-4"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="arrow-war-tech" text="" picking-mode="Ignore" class="war-attr-arrow"/>
                        <ui:VisualElement picking-mode="Ignore" class="war-btn-slot">
                            <ui:Button name="btn-invest-tech" text="+" picking-mode="Position" class="war-invest-plus-btn"/>
                            <ui:VisualElement name="tooltip-invest-tech" picking-mode="Ignore" class="war-invest-tooltip tooltip-economy hidden">
                                <ui:VisualElement picking-mode="Ignore" class="tooltip-mini-icon tooltip-icon-economy"/>
                                <ui:VisualElement picking-mode="Ignore" class="tooltip-mini-track">
                                    <ui:VisualElement name="tooltip-fill-economy" picking-mode="Ignore" class="tooltip-mini-fill" style="width: 50%;"/>
                                </ui:VisualElement>
                                <ui:Label name="tooltip-value-economy" text="50%" picking-mode="Ignore" class="tooltip-mini-value"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="war-row-troops" picking-mode="Ignore" class="war-attr-row">
                        <ui:VisualElement name="icon-war-troops" picking-mode="Ignore" class="war-attr-icon war-icon-troops"/>
                        <ui:VisualElement name="war-bar-troops" picking-mode="Ignore" class="war-level-bar">
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-1">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-1"/>
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-2">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-2"/>
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-3">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-3"/>
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="war-level-seg war-seg-4">
                                <ui:VisualElement picking-mode="Ignore" class="war-level-seg-fill war-fill-4"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="arrow-war-troops" text="" picking-mode="Ignore" class="war-attr-arrow"/>
                        <ui:VisualElement picking-mode="Ignore" class="war-btn-slot">
                            <ui:Button name="btn-invest-troops" text="+" picking-mode="Position" class="war-invest-plus-btn"/>
                            <ui:VisualElement name="tooltip-invest-troops" picking-mode="Ignore" class="war-invest-tooltip tooltip-people hidden">
                                <ui:VisualElement picking-mode="Ignore" class="tooltip-mini-icon tooltip-icon-people"/>
                                <ui:VisualElement picking-mode="Ignore" class="tooltip-mini-track">
                                    <ui:VisualElement name="tooltip-fill-people" picking-mode="Ignore" class="tooltip-mini-fill" style="width: 50%;"/>
                                </ui:VisualElement>
                                <ui:Label name="tooltip-value-people" text="50%" picking-mode="Ignore" class="tooltip-mini-value"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="war-invest-column" picking-mode="Ignore" class="war-invest-column">
                    <ui:Label text="INVESTIMENTOS" picking-mode="Ignore" class="war-invest-label"/>
                    <ui:VisualElement name="war-invest-bar" picking-mode="Ignore" class="war-invest-bar">
                        <ui:VisualElement picking-mode="Ignore" class="war-invest-seg">
                            <ui:VisualElement picking-mode="Ignore" class="war-invest-seg-fill"/>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="war-invest-seg">
                            <ui:VisualElement picking-mode="Ignore" class="war-invest-seg-fill"/>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="war-invest-seg">
                            <ui:VisualElement picking-mode="Ignore" class="war-invest-seg-fill"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="bottom-status-bar">
            <ui:Label name="dynamic-log-entry" text="&gt; [SISTEMA] Telemetria operacional. Aguardando despachos..." picking-mode="Ignore" class="dynamic-log-label"/>
            <ui:Label text="SISGOV v2.5" picking-mode="Ignore" class="system-version-label"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
