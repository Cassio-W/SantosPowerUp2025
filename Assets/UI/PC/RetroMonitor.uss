/* ========================================================================= */
/* MANDATO — RETRO CRT WORKSTATION MONITOR OS (SISGOV)                       */
/*                                                                           */
/* FONT: RETROTECH.ttf                                                       */
/* Design Limpo, Alto Contraste, Bevels 2D Retrô, Estados Instantâneos        */
/* ========================================================================= */

:root {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');

    width: 100%;
    height: 100%;
    background-color: #03070b;
    padding: 10px;
    justify-content: space-between;
}

.screen-root {
    width: 100%;
    height: 100%;
    background-color: #03070b;
    padding: 10px;
    justify-content: space-between;
}

Label {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    margin: 0;
    padding: 0;
}

/* ========================================================================= */
/* TOP SYSTEM BAR                                                            */
/* ========================================================================= */

.top-compact-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #0a1622;
    height: 38px;
    min-height: 38px;

    /* Raised Bevel Border */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #2b4c6b;
    border-left-color: #2b4c6b;
    border-right-color: #04080d;
    border-bottom-color: #04080d;
    border-radius: 0;

    padding: 0 14px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.system-tag-box {
    flex-direction: row;
    align-items: center;
}

.system-status-led {
    width: 10px;
    height: 10px;
    background-color: #22c55e;
    margin-right: 10px;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #86efac;
    border-left-color: #86efac;
    border-right-color: #14532d;
    border-bottom-color: #14532d;
    border-radius: 0;
}

.system-compact-title {
    font-size: 18px;
    color: #38bdf8;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-right: 16px;
}

/* SITUAÇÃO (Eixo político / Estado de Governo) */
.situation-box {
    background-color: #050d14;
    padding: 3px 12px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #02060a;
    border-left-color: #02060a;
    border-right-color: #1a3a54;
    border-bottom-color: #1a3a54;
    border-radius: 0;
}

.situation-label {
    font-size: 13px;
    color: #4ade80;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.system-top-right-box {
    flex-direction: row;
    align-items: center;
}

.date-compact-chip {
    font-size: 16px;
    color: #99f6e4;
    background-color: #050e17;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #02060b;
    border-left-color: #02060b;
    border-right-color: #0284c7;
    border-bottom-color: #0284c7;
    border-radius: 0;

    padding: 3px 14px;
    -unity-font-style: bold;
}

/* ========================================================================= */
/* MAIN WORKSPACE                                                            */
/* ========================================================================= */

.main-workspace {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
}

/* ========================================================================= */
/* 76% APPS GRID CONTAINER (2 ROWS OF 2 CARDS)                               */
/* ========================================================================= */

.apps-grid-container {
    width: 76%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
}

.cards-row {
    flex-direction: row;
    width: 100%;
    height: 48.5%;
    justify-content: space-between;
}

/* ========================================================================= */
/* GIANT CARD                                                                */
/* ========================================================================= */

.giant-card {
    width: 48.8%;
    height: 100%;
    position: relative;
    background-color: #09131c;

    border-width: 2px;
    border-radius: 0;
    overflow: hidden;
    justify-content: flex-end; /* Preenchimento cresce de baixo para cima */
}

/* Background Level Fill */
.card-bg-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
}

.fill-nature-bg {
    background-color: rgba(34, 197, 94, 0.42);
    border-top-width: 4px;
    border-top-color: #4ade80;
}

.fill-economy-bg {
    background-color: rgba(234, 179, 8, 0.42);
    border-top-width: 4px;
    border-top-color: #facc15;
}

.fill-relations-bg {
    background-color: rgba(56, 189, 248, 0.42);
    border-top-width: 4px;
    border-top-color: #7dd3fc;
}

.fill-people-bg {
    background-color: rgba(244, 114, 182, 0.42);
    border-top-width: 4px;
    border-top-color: #f472b6;
}

/* Conteúdo sobreposto (Ícone + Porcentagem Lado a Lado) */
.card-foreground {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    padding: 10px 16px;
}

.giant-icon {
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.giant-value {
    font-size: 50px;
    color: #ffffff;
    background-color: #03080e;

    /* Sunken LCD Readout Bevel */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #010408;
    border-left-color: #010408;
    border-right-color: #1e364e;
    border-bottom-color: #1e364e;
    border-radius: 0;

    padding: 8px 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* Cores específicas de bordas e valores por setor */
.card-nature {
    border-top-color: #4ade80;
    border-left-color: #4ade80;
    border-right-color: #0f4024;
    border-bottom-color: #0f4024;
}
.card-nature .giant-value {
    color: #4ade80;
    border-right-color: #22c55e;
    border-bottom-color: #22c55e;
}

.card-economy {
    border-top-color: #facc15;
    border-left-color: #facc15;
    border-right-color: #52400a;
    border-bottom-color: #52400a;
}
.card-economy .giant-value {
    color: #facc15;
    border-right-color: #eab308;
    border-bottom-color: #eab308;
}

.card-relations {
    border-top-color: #7dd3fc;
    border-left-color: #7dd3fc;
    border-right-color: #0c3954;
    border-bottom-color: #0c3954;
}
.card-relations .giant-value {
    color: #7dd3fc;
    border-right-color: #38bdf8;
    border-bottom-color: #38bdf8;
}

.card-people {
    border-top-color: #f472b6;
    border-left-color: #f472b6;
    border-right-color: #52183c;
    border-bottom-color: #52183c;
}
.card-people .giant-value {
    color: #f472b6;
    border-right-color: #f472b6;
    border-bottom-color: #f472b6;
}

/* ============================================================
   21% VERTICAL CORRUPTION PILLAR (RIGHT PANEL)
   ============================================================ */
.giant-corruption-pillar {
    width: 21.5%;
    height: 100%;
    position: relative;
    background-color: #1a0609;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #ff3344;
    border-left-color: #ff3344;
    border-right-color: #4a080f;
    border-bottom-color: #4a080f;
    border-radius: 0;

    overflow: hidden;
    justify-content: flex-end;
}

.corruption-bg-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(220, 38, 38, 0.65);
    border-top-width: 5px;
    border-top-color: #ff2244;
}

.corruption-foreground {
    width: 100%;
    height: 100%;
    padding: 14px 10px;
    justify-content: space-between;
    align-items: center;
}

.giant-corruption-value {
    font-size: 46px;
    color: #ff3344;
    background-color: #0a0204;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #040102;
    border-left-color: #040102;
    border-right-color: #ef4444;
    border-bottom-color: #ef4444;
    border-radius: 0;

    padding: 6px 18px;
    margin-top: 4px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.corruption-center-box {
    width: 100%;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.giant-corruption-icon {
    width: 95px;
    height: 95px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

/* ============================================================
   FEEDBACK DE VARIAÇÃO — SETA (▲▼)
   ============================================================ */
.attr-arrow {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 46px;
    height: 46px;
    background-color: #060b12;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #3b5670;
    border-left-color: #3b5670;
    border-right-color: #020508;
    border-bottom-color: #020508;
    border-radius: 0;

    justify-content: center;
    align-items: center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
}

.attr-arrow.arrow-up {
    border-color: #22c55e;
    color: #22c55e;
}

.attr-arrow.arrow-down {
    border-color: #ef4444;
    color: #ef4444;
}

.attr-arrow.arrow-up-bad {
    border-color: #ef4444;
    color: #ef4444;
}

.attr-arrow.arrow-down-good {
    border-color: #22c55e;
    color: #22c55e;
}

/* ============================================================
   GHOST FILL — Preenchimento Fantasma
   ============================================================ */
.ghost-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
}

.ghost-nature {
    background-color: rgba(34, 197, 94, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(74, 222, 128, 0.65);
}

.ghost-economy {
    background-color: rgba(234, 179, 8, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(250, 204, 21, 0.65);
}

.ghost-relations {
    background-color: rgba(56, 189, 248, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(125, 211, 252, 0.65);
}

.ghost-people {
    background-color: rgba(244, 114, 182, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(244, 114, 182, 0.65);
}

.ghost-corruption {
    background-color: rgba(220, 38, 38, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(255, 34, 68, 0.65);
}

/* ============================================================
   FEEDBACK — OVERLAY DE ATRIBUTO ZERADO (✕)
   ============================================================ */
.dead-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 2, 4, 0.9);
    border-width: 2px;
    border-color: #ef4444;
    border-radius: 0;
    justify-content: center;
    align-items: center;
}

.dead-x-label {
    font-size: 68px;
    color: #ef4444;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ============================================================
   BOTTOM STATUS BAR (Terminal Log + Versão do Sistema)
   ============================================================ */
.bottom-status-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #08121a;
    height: 28px;
    min-height: 28px;

    /* Inset Terminal Bevel */
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #03070b;
    border-left-color: #03070b;
    border-right-color: #1e364e;
    border-bottom-color: #1e364e;
    border-radius: 0;

    padding: 0 12px;
    margin-top: 8px;
    flex-shrink: 0;
}

.dynamic-log-label {
    font-size: 12px;
    color: #4ade80;
    letter-spacing: 1px;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dynamic-log-label.log-system {
    color: #4ade80;
}

.dynamic-log-label.log-dispatch {
    color: #38bdf8;
}

.dynamic-log-label.log-warning {
    color: #facc15;
}

.dynamic-log-label.log-alert {
    color: #ef4444;
}

.system-version-label {
    font-size: 11px;
    color: #64748b;
    letter-spacing: 1px;
    margin-left: 12px;
}

/* ============================================================
   ESTADOS AUXILIARES & SHAKE
   ============================================================ */
.card-dead {
    border-color: #5a0000;
}

.card-dead .card-bg-fill {
    background-color: rgba(100, 0, 0, 0.55);
}

.card-full {
    border-color: rgba(255, 255, 255, 0.85);
}

.card-full-glow {
    border-color: rgba(255, 255, 255, 0.35);
}

.hidden {
    display: none;
    visibility: hidden;
    opacity: 0;
}

.card-shaking {
    translate: 5px 0;
}

/* ============================================================
   FEEDBACK DE HOVER 3D (WorldSpaceUIInteraction)
   ============================================================ */
.giant-card.hovered {
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #3b5670;
    border-bottom-color: #3b5670;
    background-color: #0f1e2c;
}

.giant-card.hovered .giant-value {
    background-color: #050f18;
    border-top-color: #0a1622;
    border-left-color: #0a1622;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

.giant-corruption-pillar.hovered {
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #7f1d1d;
    border-bottom-color: #7f1d1d;
    background-color: #2b080c;
}

.giant-corruption-pillar.hovered .giant-corruption-value {
    background-color: #120306;
    border-top-color: #1a0609;
    border-left-color: #1a0609;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

/* ============================================================
   TABS DE NAVEGAÇÃO NO TOPO (GOVERNO / GUERRA)
   ============================================================ */
Button {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
}

.pc-tabs-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pc-tab-btn {
    height: 28px;
    padding: 0 20px;
    margin: 0 4px;
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    background-color: #050d14;
    color: #64748b;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #1e364e;
    border-left-color: #1e364e;
    border-right-color: #020508;
    border-bottom-color: #020508;
    border-radius: 0;
}

.pc-tab-btn.active-tab {
    background-color: #0c2538;
    color: #38bdf8;
    border-top-color: #38bdf8;
    border-left-color: #38bdf8;
    border-right-color: #075985;
    border-bottom-color: #075985;
}

.pc-tab-war.active-tab {
    background-color: #31090e;
    color: #ff4d5e;
    border-top-color: #ff3344;
    border-left-color: #ff3344;
    border-right-color: #7f1d1d;
    border-bottom-color: #7f1d1d;
}

.pc-tab-btn.hovered,
.pc-tab-btn:hover {
    color: #ffffff;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
}

/* ============================================================
   ABA DE GUERRA (WAR WORKSPACE)
   ============================================================ */
.war-workspace {
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    overflow: visible;
}

.war-general-panel {
    width: 100%;
    height: 78px;
    min-height: 78px;
    background-color: #09131c;
    padding: 6px 12px;
    margin-bottom: 8px;
    flex-shrink: 0;
    justify-content: space-between;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #ff3344;
    border-left-color: #ff3344;
    border-right-color: #4a080f;
    border-bottom-color: #4a080f;
    border-radius: 0;
}

.war-general-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.war-general-right-box {
    flex-direction: row;
    align-items: center;
}

.war-pc-title {
    font-size: 14px;
    color: #facc15;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.war-pc-percent {
    font-size: 14px;
    color: #ffffff;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.war-surrender-pc-btn {
    height: 22px;
    padding: 0 10px;
    margin-right: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: #3b0a11;
    color: #fca5a5;
    border-width: 2px;
    border-top-color: #ff3344;
    border-left-color: #ff3344;
    border-right-color: #4a080f;
    border-bottom-color: #4a080f;
    border-radius: 0;
}

.war-surrender-pc-btn.hovered,
.war-surrender-pc-btn:hover {
    background-color: #5c101b;
    color: #ffffff;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
}

.war-pc-bar-track {
    flex-direction: row;
    width: 100%;
    height: 32px;
    background-color: #03080e;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #010408;
    border-left-color: #010408;
    border-right-color: #1e364e;
    border-bottom-color: #1e364e;
    border-radius: 0;
}

.war-pc-player-fill {
    height: 100%;
    width: 50%;
    flex-shrink: 0;
    background-color: #22c55e;
}

.war-pc-bar-divider {
    width: 3px;
    height: 100%;
    flex-shrink: 0;
    background-color: #ffffff;
}

.war-pc-enemy-fill {
    height: 100%;
    width: 50%;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: #dc2626;
}

/* ============================================================
   CARDS DE TECNOLOGIA & TROPAS NA ABA DE GUERRA
   ============================================================ */
.war-cards-row {
    flex-direction: row;
    width: 100%;
    flex-grow: 1;
    justify-content: space-between;
    overflow: visible;
}

.card-war-tech {
    border-top-color: #38bdf8;
    border-left-color: #38bdf8;
    border-right-color: #0c3954;
    border-bottom-color: #0c3954;
    overflow: visible;
}

.card-war-tech .giant-value {
    color: #7dd3fc;
    border-right-color: #38bdf8;
    border-bottom-color: #38bdf8;
}

.fill-tech-bg {
    background-color: rgba(56, 189, 248, 0.42);
    border-top-width: 4px;
    border-top-color: #7dd3fc;
}

.ghost-tech {
    background-color: rgba(56, 189, 248, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(125, 211, 252, 0.65);
}

.card-war-troops {
    border-top-color: #4ade80;
    border-left-color: #4ade80;
    border-right-color: #0f4024;
    border-bottom-color: #0f4024;
    overflow: visible;
}

.card-war-troops .giant-value {
    color: #4ade80;
    border-right-color: #22c55e;
    border-bottom-color: #22c55e;
}

.fill-troops-bg {
    background-color: rgba(34, 197, 94, 0.42);
    border-top-width: 4px;
    border-top-color: #4ade80;
}

.ghost-troops {
    background-color: rgba(34, 197, 94, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(74, 222, 128, 0.65);
}

.war-card-foreground {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px 14px;
}

.war-card-top-info {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.war-card-title-tech {
    font-size: 20px;
    color: #7dd3fc;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.war-card-title-troops {
    font-size: 20px;
    color: #4ade80;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.war-card-subtitle {
    font-size: 11px;
    color: #94a3b8;
    letter-spacing: 1px;
    background-color: rgba(3, 8, 14, 0.85);
    padding: 2px 6px;
}

.war-card-center-readout {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
}

.war-giant-value {
    font-size: 34px;
    padding: 4px 16px;
}

.war-card-bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(3, 8, 14, 0.9);
    padding: 4px 10px;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #010408;
    border-left-color: #010408;
    border-right-color: #1e364e;
    border-bottom-color: #1e364e;
    border-radius: 0;
}

.war-invest-caption {
    font-size: 14px;
    color: #e2e8f0;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.war-invest-plus-btn {
    width: 52px;
    height: 36px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: #0d2b1d;
    color: #4ade80;
    padding: 0;
    margin: 0;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #4ade80;
    border-left-color: #4ade80;
    border-right-color: #05140d;
    border-bottom-color: #05140d;
    border-radius: 0;
}

.war-invest-plus-btn.hovered,
.war-invest-plus-btn:hover {
    background-color: #194d34;
    color: #ffffff;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
}

.war-invest-plus-btn.btn-disabled {
    background-color: #070d12;
    color: #475569;
    border-top-color: #1e293b;
    border-left-color: #1e293b;
    border-right-color: #020508;
    border-bottom-color: #020508;
}

/* ============================================================
   TOOLTIP CARD SOBRE O BOTÃO + (MOSTRA BARRA E % DO ATRIBUTO)
   ============================================================ */
.war-invest-tooltip {
    position: absolute;
    bottom: 58px;
    right: 12px;
    width: 220px;
    height: 118px;
    background-color: #060d14;
    border-width: 2px;
    border-radius: 0;
    overflow: hidden;
    justify-content: flex-end;
}

.tooltip-foreground {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px 10px;
}

.tooltip-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(3, 8, 14, 0.88);
    padding: 3px 8px;
}

.tooltip-attr-title {
    font-size: 13px;
    color: #ffffff;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.tooltip-cost-tag {
    font-size: 12px;
    color: #ef4444;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.tooltip-body-row {
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    flex-grow: 1;
}

.tooltip-mini-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.tooltip-mini-value {
    font-size: 24px;
    color: #ffffff;
    background-color: #03080e;
    padding: 4px 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #010408;
    border-left-color: #010408;
    border-right-color: #1e364e;
    border-bottom-color: #1e364e;
    border-radius: 0;
}

.card-economy .tooltip-mini-value {
    color: #facc15;
    border-right-color: #eab308;
    border-bottom-color: #eab308;
}

.card-people .tooltip-mini-value {
    color: #f472b6;
    border-right-color: #f472b6;
    border-bottom-color: #f472b6;
}


