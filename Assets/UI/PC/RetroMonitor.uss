/* ============================================================
   RETRO CRT MONITOR OS STYLESHEET
   FONT: RETROTECH.ttf | CLEAN ICON + VALUE LAYOUT
   ============================================================ */

:root {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');

    width: 100%;
    height: 100%;
    background-color: #03070a;
    padding: 16px;
    box-sizing: border-box;
    justify-content: space-between;
}

.screen-root {
    width: 100%;
    height: 100%;
    background-color: #03070a;
    padding: 16px;
    box-sizing: border-box;
    justify-content: space-between;
}

Label {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
}

/* ============================================================
   COMPACT TOP BAR
   ============================================================ */
.top-compact-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(6, 16, 22, 0.95);
    border-width: 2px;
    border-color: #1a4454;
    border-radius: 6px;
    padding: 6px 18px;
    margin-bottom: 14px;
}

.system-tag-box {
    flex-direction: row;
    align-items: center;
}

.system-status-led {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #22c55e;
    margin-right: 12px;
    border-width: 2px;
    border-color: #86efac;
}

.system-compact-title {
    font-size: 20px;
    color: #38bdf8;
    letter-spacing: 2px;
}

.date-compact-chip {
    font-size: 18px;
    color: #99f6e4;
    background-color: rgba(15, 23, 42, 0.9);
    border-width: 1px;
    border-color: #0284c7;
    border-radius: 4px;
    padding: 3px 14px;
}

/* ============================================================
   MAIN VIEWPORT (APPS GRID + CORRUPTION PILLAR)
   ============================================================ */
.main-workspace {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
}

/* ============================================================
   76% APPS CONTAINER (2 ROWS OF 2 CARDS)
   ============================================================ */
.apps-grid-container {
    width: 76%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
}

.cards-row {
    flex-direction: row;
    width: 100%;
    height: 48%;
    justify-content: space-between;
}

/* ============================================================
   GIANT CARD
   ============================================================ */
.giant-card {
    width: 48.5%;
    height: 100%;
    position: relative;
    background-color: rgba(8, 20, 28, 0.95);
    border-width: 3px;
    border-color: #1e3a4a;
    border-radius: 12px;
    overflow: hidden;
    justify-content: flex-end; /* Preenchimento cresce de baixo para cima */
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.giant-card:hover {
    scale: 1.015 1.015;
}

/* Background Fill de nível */
.card-bg-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
}

.fill-nature-bg {
    background-color: rgba(34, 197, 94, 0.42);
    border-top-width: 5px;
    border-top-color: #4ade80;
}

.fill-economy-bg {
    background-color: rgba(234, 179, 8, 0.42);
    border-top-width: 5px;
    border-top-color: #facc15;
}

.fill-relations-bg {
    background-color: rgba(56, 189, 248, 0.42);
    border-top-width: 5px;
    border-top-color: #7dd3fc;
}

.fill-people-bg {
    background-color: rgba(244, 114, 182, 0.42);
    border-top-width: 5px;
    border-top-color: #f472b6;
}

/* Conteúdo sobreposto (Ícone + Porcentagem Lado a Lado) */
.card-foreground {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    padding: 10px 16px;
}

.giant-icon {
    width: 130px;
    height: 130px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.giant-value {
    font-size: 54px;
    color: #ffffff;
    background-color: rgba(2, 6, 12, 0.94);
    border-width: 2px;
    border-radius: 10px;
    padding: 8px 24px;
    letter-spacing: 2px;
}

/* Cores específicas de bordas e valores */
.card-nature { border-color: #22c55e; }
.card-nature .giant-value { color: #4ade80; border-color: #22c55e; }
.card-nature:hover { border-color: #4ade80; }

.card-economy { border-color: #eab308; }
.card-economy .giant-value { color: #facc15; border-color: #eab308; }
.card-economy:hover { border-color: #facc15; }

.card-relations { border-color: #38bdf8; }
.card-relations .giant-value { color: #7dd3fc; border-color: #38bdf8; }
.card-relations:hover { border-color: #7dd3fc; }

.card-people { border-color: #f472b6; }
.card-people .giant-value { color: #f472b6; border-color: #f472b6; }
.card-people:hover { border-color: #f472b6; }

/* ============================================================
   21% VERTICAL CORRUPTION PILLAR (FULL HEIGHT)
   ============================================================ */
.giant-corruption-pillar {
    width: 21%;
    height: 100%;
    margin-left: 18px;
    position: relative;
    background-color: rgba(26, 4, 8, 0.95);
    border-width: 3px;
    border-color: #dc2626;
    border-radius: 12px;
    overflow: hidden;
    justify-content: flex-end; /* Preenchimento cresce de baixo para cima */
}

.corruption-bg-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(220, 38, 38, 0.65);
    border-top-width: 6px;
    border-top-color: #ff2244;
}

.corruption-foreground {
    width: 100%;
    height: 100%;
    padding: 16px 10px;
    justify-content: space-between;
    align-items: center;
}

.giant-corruption-value {
    font-size: 50px;
    color: #ff3344;
    background-color: rgba(10, 2, 4, 0.94);
    border-width: 2px;
    border-color: #ef4444;
    border-radius: 10px;
    padding: 6px 18px;
    margin-top: 8px;
    letter-spacing: 2px;
}

.corruption-center-box {
    width: 100%;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.giant-corruption-icon {
    width: 100px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

/* ============================================================
   FEEDBACK DE VARIAÇÃO — SETA (▲▼)
   ============================================================ */
.attr-arrow {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    background-color: rgba(6, 10, 16, 0.94);
    border-width: 3px;
    justify-content: center;
    align-items: center;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
}

.attr-arrow.arrow-up {
    border-color: #22c55e;
    color: #22c55e;
}

.attr-arrow.arrow-down {
    border-color: #ef4444;
    color: #ef4444;
}

/* Para corrupção: ▲ = piora (vermelho), ▼ = melhora (verde) */
.attr-arrow.arrow-up-bad {
    border-color: #ef4444;
    color: #ef4444;
}

.attr-arrow.arrow-down-good {
    border-color: #22c55e;
    color: #22c55e;
}

/* ============================================================
   GHOST FILL — preenchimento fantasma de variação
   ============================================================ */
.ghost-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
}

.ghost-nature {
    background-color: rgba(34, 197, 94, 0.22);
    border-top-width: 4px;
    border-top-color: rgba(74, 222, 128, 0.65);
}

.ghost-economy {
    background-color: rgba(234, 179, 8, 0.22);
    border-top-width: 4px;
    border-top-color: rgba(250, 204, 21, 0.65);
}

.ghost-relations {
    background-color: rgba(56, 189, 248, 0.22);
    border-top-width: 4px;
    border-top-color: rgba(125, 211, 252, 0.65);
}

.ghost-people {
    background-color: rgba(244, 114, 182, 0.22);
    border-top-width: 4px;
    border-top-color: rgba(244, 114, 182, 0.65);
}

.ghost-corruption {
    background-color: rgba(220, 38, 38, 0.22);
    border-top-width: 4px;
    border-top-color: rgba(255, 34, 68, 0.65);
}

/* ============================================================
   FEEDBACK — OVERLAY DE ATRIBUTO ZERADO (✕)
   ============================================================ */
.dead-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    justify-content: center;
    align-items: center;
}

.dead-x-label {
    font-size: 72px;
    color: #ef4444;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: #ef4444;
}

/* ============================================================
   ESTADO ZERADO — card-dead
   ============================================================ */
.card-dead {
    border-color: #5a0000;
}

.card-dead .card-bg-fill {
    background-color: rgba(100, 0, 0, 0.55);
}

/* ============================================================
   ESTADO 100% — card-full (brilho pulsante APENAS na borda)
   ============================================================ */
.card-full {
    border-color: rgba(255, 255, 255, 0.85);
    transition-property: border-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.card-full-glow {
    border-color: rgba(255, 255, 255, 0.25);
    transition-property: border-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

/* ============================================================
   HELPER — hidden
   ============================================================ */
.hidden {
    visibility: hidden;
    opacity: 0;
}

/* ============================================================
   SHAKE — classe aplicada e removida via script
   ============================================================ */
.card-shaking {
    translate: 5px 0;
    transition-property: translate;
    transition-duration: 0.05s;
    transition-timing-function: ease-in-out;
}
