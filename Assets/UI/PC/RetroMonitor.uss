/* ========================================================================= */
/* MANDATO — RETRO CRT WORKSTATION MONITOR OS (SISGOV)                       */
/*                                                                           */
/* FONT: RETROTECH.ttf                                                       */
/* Design Limpo, Alto Contraste, Bevels 2D Retrô, Estados Instantâneos        */
/* ========================================================================= */

:root {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');

    width: 100%;
    height: 100%;
    background-color: #03070b;
    padding: 10px;
    justify-content: space-between;
}

.screen-root {
    width: 100%;
    height: 100%;
    background-color: #03070b;
    padding: 10px;
    justify-content: space-between;
}

Label {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    margin: 0;
    padding: 0;
}

/* ========================================================================= */
/* TOP SYSTEM BAR                                                            */
/* ========================================================================= */

.top-compact-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #0a1622;
    height: 38px;
    min-height: 38px;

    /* Raised Bevel Border */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #3b658d;
    border-left-color: #3b658d;
    border-right-color: #102436;
    border-bottom-color: #102436;
    border-radius: 0;

    padding: 0 14px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.system-tag-box {
    flex-direction: row;
    align-items: center;
}

.system-status-led {
    width: 10px;
    height: 10px;
    background-color: #22c55e;
    margin-right: 10px;

    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #86efac;
    border-left-color: #86efac;
    border-right-color: #14532d;
    border-bottom-color: #14532d;
    border-radius: 0;
}

.system-compact-title {
    font-size: 18px;
    color: #38bdf8;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-right: 16px;
}

/* SITUAÇÃO (Eixo político / Estado de Governo) */
.situation-box {
    background-color: #050d14;
    padding: 3px 12px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #133924;
    border-left-color: #133924;
    border-right-color: #22c55e;
    border-bottom-color: #22c55e;
    border-radius: 0;
}

.situation-label {
    font-size: 13px;
    color: #4ade80;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.system-top-right-box {
    flex-direction: row;
    align-items: center;
}

.date-compact-chip {
    font-size: 16px;
    color: #99f6e4;
    background-color: #050e17;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #0d3852;
    border-left-color: #0d3852;
    border-right-color: #38bdf8;
    border-bottom-color: #38bdf8;
    border-radius: 0;

    padding: 3px 14px;
    -unity-font-style: bold;
}

/* ========================================================================= */
/* MAIN WORKSPACE                                                            */
/* ========================================================================= */

.main-workspace {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
}

/* ========================================================================= */
/* 76% APPS GRID CONTAINER (2 ROWS OF 2 CARDS)                               */
/* ========================================================================= */

.apps-grid-container {
    width: 76%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
}

.cards-row {
    flex-direction: row;
    width: 100%;
    height: 48.5%;
    justify-content: space-between;
}

/* ========================================================================= */
/* GIANT CARD                                                                */
/* ========================================================================= */

.giant-card {
    width: 48.8%;
    height: 100%;
    position: relative;
    background-color: #09131c;

    border-width: 2px;
    border-radius: 0;
    overflow: hidden;
    justify-content: flex-end; /* Preenchimento cresce de baixo para cima */
}

/* Background Level Fill */
.card-bg-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
}

.fill-nature-bg {
    background-color: rgba(34, 197, 94, 0.42);
    border-top-width: 4px;
    border-top-color: #4ade80;
}

.fill-economy-bg {
    background-color: rgba(234, 179, 8, 0.42);
    border-top-width: 4px;
    border-top-color: #facc15;
}

.fill-relations-bg {
    background-color: rgba(56, 189, 248, 0.42);
    border-top-width: 4px;
    border-top-color: #7dd3fc;
}

.fill-people-bg {
    background-color: rgba(244, 114, 182, 0.42);
    border-top-width: 4px;
    border-top-color: #f472b6;
}

/* Conteúdo sobreposto (Ícone + Porcentagem Lado a Lado) */
.card-foreground {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    padding: 10px 16px;
}

.giant-icon {
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.giant-value {
    font-size: 50px;
    color: #ffffff;
    background-color: #03080e;

    /* Sunken LCD Readout Bevel */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #102436;
    border-left-color: #102436;
    border-right-color: #2f567c;
    border-bottom-color: #2f567c;
    border-radius: 0;

    padding: 8px 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* Cores específicas de bordas e valores por setor */
.card-nature {
    border-top-color: #4ade80;
    border-left-color: #4ade80;
    border-right-color: #166534;
    border-bottom-color: #166534;
}
.card-nature .giant-value {
    color: #4ade80;
    border-top-color: #14532d;
    border-left-color: #14532d;
    border-right-color: #4ade80;
    border-bottom-color: #4ade80;
}

.card-economy {
    border-top-color: #facc15;
    border-left-color: #facc15;
    border-right-color: #854d0e;
    border-bottom-color: #854d0e;
}
.card-economy .giant-value {
    color: #facc15;
    border-top-color: #713f12;
    border-left-color: #713f12;
    border-right-color: #facc15;
    border-bottom-color: #facc15;
}

.card-relations {
    border-top-color: #7dd3fc;
    border-left-color: #7dd3fc;
    border-right-color: #0369a1;
    border-bottom-color: #0369a1;
}
.card-relations .giant-value {
    color: #7dd3fc;
    border-top-color: #075985;
    border-left-color: #075985;
    border-right-color: #7dd3fc;
    border-bottom-color: #7dd3fc;
}

.card-people {
    border-top-color: #f472b6;
    border-left-color: #f472b6;
    border-right-color: #9d174d;
    border-bottom-color: #9d174d;
}
.card-people .giant-value {
    color: #f472b6;
    border-top-color: #831843;
    border-left-color: #831843;
    border-right-color: #f472b6;
    border-bottom-color: #f472b6;
}

/* ============================================================
   21% VERTICAL CORRUPTION PILLAR (RIGHT PANEL)
   ============================================================ */
.giant-corruption-pillar {
    width: 21.5%;
    height: 100%;
    position: relative;
    background-color: #1a0609;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #ff3344;
    border-left-color: #ff3344;
    border-right-color: #881337;
    border-bottom-color: #881337;
    border-radius: 0;

    overflow: hidden;
    justify-content: flex-end;
}

.corruption-bg-fill {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(220, 38, 38, 0.65);
    border-top-width: 5px;
    border-top-color: #ff2244;
}

.corruption-foreground {
    width: 100%;
    height: 100%;
    padding: 14px 10px;
    justify-content: space-between;
    align-items: center;
}

.giant-corruption-value {
    font-size: 46px;
    color: #ff3344;
    background-color: #0a0204;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #881337;
    border-left-color: #881337;
    border-right-color: #ff4d5e;
    border-bottom-color: #ff4d5e;
    border-radius: 0;

    padding: 6px 18px;
    margin-top: 4px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.corruption-center-box {
    width: 100%;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.giant-corruption-icon {
    width: 95px;
    height: 95px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

/* ============================================================
   FEEDBACK DE VARIAÇÃO — SETA (▲▼)
   ============================================================ */
.attr-arrow {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 46px;
    height: 46px;
    background-color: #060b12;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #3b5670;
    border-left-color: #3b5670;
    border-right-color: #102436;
    border-bottom-color: #102436;
    border-radius: 0;

    justify-content: center;
    align-items: center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
}

.attr-arrow.arrow-up {
    border-color: #22c55e;
    color: #22c55e;
}

.attr-arrow.arrow-down {
    border-color: #ef4444;
    color: #ef4444;
}

.attr-arrow.arrow-up-bad {
    border-color: #ef4444;
    color: #ef4444;
}

.attr-arrow.arrow-down-good {
    border-color: #22c55e;
    color: #22c55e;
}

/* ============================================================
   GHOST FILL — Preenchimento Fantasma
   ============================================================ */
.ghost-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
}

.ghost-nature {
    background-color: rgba(34, 197, 94, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(74, 222, 128, 0.65);
}

.ghost-economy {
    background-color: rgba(234, 179, 8, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(250, 204, 21, 0.65);
}

.ghost-relations {
    background-color: rgba(56, 189, 248, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(125, 211, 252, 0.65);
}

.ghost-people {
    background-color: rgba(244, 114, 182, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(244, 114, 182, 0.65);
}

.ghost-corruption {
    background-color: rgba(220, 38, 38, 0.22);
    border-top-width: 3px;
    border-top-color: rgba(255, 34, 68, 0.65);
}

/* ============================================================
   FEEDBACK — OVERLAY DE ATRIBUTO ZERADO (✕)
   ============================================================ */
.dead-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 2, 4, 0.9);
    border-width: 2px;
    border-color: #ef4444;
    border-radius: 0;
    justify-content: center;
    align-items: center;
}

.dead-x-label {
    font-size: 68px;
    color: #ef4444;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ============================================================
   BOTTOM STATUS BAR (Terminal Log + Versão do Sistema)
   ============================================================ */
.bottom-status-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #08121a;
    height: 28px;
    min-height: 28px;

    /* Inset Terminal Bevel */
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #102436;
    border-left-color: #102436;
    border-right-color: #2f567c;
    border-bottom-color: #2f567c;
    border-radius: 0;

    padding: 0 12px;
    margin-top: 8px;
    flex-shrink: 0;
}

.dynamic-log-label {
    font-size: 12px;
    color: #4ade80;
    letter-spacing: 1px;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dynamic-log-label.log-system {
    color: #4ade80;
}

.dynamic-log-label.log-dispatch {
    color: #38bdf8;
}

.dynamic-log-label.log-warning {
    color: #facc15;
}

.dynamic-log-label.log-alert {
    color: #ef4444;
}

.system-version-label {
    font-size: 11px;
    color: #64748b;
    letter-spacing: 1px;
    margin-left: 12px;
}

/* ============================================================
   ESTADOS AUXILIARES & SHAKE
   ============================================================ */
.card-dead {
    border-color: #5a0000;
}

.card-dead .card-bg-fill {
    background-color: rgba(100, 0, 0, 0.55);
}

.card-full {
    border-color: rgba(255, 255, 255, 0.85);
}

.card-full-glow {
    border-color: rgba(255, 255, 255, 0.35);
}

.hidden {
    display: none;
    visibility: hidden;
    opacity: 0;
}

.card-shaking {
    translate: 5px 0;
}

/* ============================================================
   FEEDBACK DE HOVER 3D (WorldSpaceUIInteraction)
   ============================================================ */
.giant-card.hovered {
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #386087;
    border-bottom-color: #386087;
    background-color: #0f1e2c;
}

.giant-card.hovered .giant-value {
    background-color: #050f18;
    border-top-color: #102436;
    border-left-color: #102436;
    border-right-color: #ffffff;
    border-bottom-color: #ffffff;
}

/* Hover específico para cada setor com 4 bordas nítidas */
.card-nature.hovered {
    border-top-color: #86efac;
    border-left-color: #86efac;
    border-right-color: #15803d;
    border-bottom-color: #15803d;
    background-color: #0a1f13;
}
.card-nature.hovered .giant-value {
    background-color: #04120a;
    border-top-color: #166534;
    border-left-color: #166534;
    border-right-color: #86efac;
    border-bottom-color: #86efac;
}

.card-economy.hovered {
    border-top-color: #fef08a;
    border-left-color: #fef08a;
    border-right-color: #a16207;
    border-bottom-color: #a16207;
    background-color: #211603;
}
.card-economy.hovered .giant-value {
    background-color: #120c02;
    border-top-color: #854d0e;
    border-left-color: #854d0e;
    border-right-color: #fef08a;
    border-bottom-color: #fef08a;
}

.card-relations.hovered {
    border-top-color: #bae6fd;
    border-left-color: #bae6fd;
    border-right-color: #0284c7;
    border-bottom-color: #0284c7;
    background-color: #061826;
}
.card-relations.hovered .giant-value {
    background-color: #030d17;
    border-top-color: #0369a1;
    border-left-color: #0369a1;
    border-right-color: #bae6fd;
    border-bottom-color: #bae6fd;
}

.card-people.hovered {
    border-top-color: #fbcfe8;
    border-left-color: #fbcfe8;
    border-right-color: #be185d;
    border-bottom-color: #be185d;
    background-color: #240716;
}
.card-people.hovered .giant-value {
    background-color: #12030c;
    border-top-color: #9d174d;
    border-left-color: #9d174d;
    border-right-color: #fbcfe8;
    border-bottom-color: #fbcfe8;
}

.giant-corruption-pillar.hovered {
    border-top-color: #fda4af;
    border-left-color: #fda4af;
    border-right-color: #9f1239;
    border-bottom-color: #9f1239;
    background-color: #2b080c;
}

.giant-corruption-pillar.hovered .giant-corruption-value {
    background-color: #120306;
    border-top-color: #881337;
    border-left-color: #881337;
    border-right-color: #fda4af;
    border-bottom-color: #fda4af;
}

/* ============================================================
   TABS DE NAVEGAÇÃO NO TOPO (GOVERNO / GUERRA)
   ============================================================ */
Button {
    -unity-font: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
    -unity-font-definition: url('project://database/Assets/RETROTECH.ttf?fileID=12800000&guid=3d5c7b9b29723fd4cbdc199842b451c8&type=3#RETROTECH');
}

.pc-tabs-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pc-tab-btn {
    height: 28px;
    padding: 0 20px;
    margin: 0 4px;
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    background-color: #050d14;
    color: #64748b;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #386087;
    border-left-color: #386087;
    border-right-color: #102436;
    border-bottom-color: #102436;
    border-radius: 0;
}

.pc-tab-btn.active-tab {
    background-color: #0c2538;
    color: #38bdf8;
    border-top-color: #38bdf8;
    border-left-color: #38bdf8;
    border-right-color: #075985;
    border-bottom-color: #075985;
}

.pc-tab-war.active-tab {
    background-color: #31090e;
    color: #ff4d5e;
    border-top-color: #ff3344;
    border-left-color: #ff3344;
    border-right-color: #7f1d1d;
    border-bottom-color: #7f1d1d;
}

.pc-tab-btn.hovered {
    color: #ffffff;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #38bdf8;
    border-bottom-color: #38bdf8;
}

/* ============================================================
   ABA DE GUERRA (WAR WORKSPACE)
   ============================================================ */
.war-workspace {
    flex-direction: column;
    flex-grow: 1;
    justify-content: flex-start;
    overflow: visible;
}

/* ---------- BARRA GERAL ---------- */
.war-general-panel {
    width: 100%;
    height: 96px;
    min-height: 96px;
    max-height: 96px;
    background-color: #081119;
    padding: 4px 12px;
    margin-bottom: 8px;
    flex-shrink: 0;
    justify-content: space-between;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #386087;
    border-left-color: #386087;
    border-right-color: #102436;
    border-bottom-color: #102436;
    border-radius: 0;
}

.war-hero-readout-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 42px;
    padding: 0 8px;
}

.war-side-box {
    flex-direction: row;
    align-items: center;
}

.war-side-player {
    justify-content: flex-start;
}

.war-side-enemy {
    justify-content: flex-end;
}

.war-side-label {
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.war-label-player {
    color: #4ade80;
    margin-right: 10px;
}

.war-label-enemy {
    color: #f87171;
    margin-left: 10px;
}

.war-giant-percent {
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.war-percent-player {
    color: #4ade80;
}

.war-percent-enemy {
    color: #ef4444;
}

.war-center-status-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.war-vs-badge {
    font-size: 18px;
    color: #facc15;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.war-surrender-pc-btn {
    height: 22px;
    padding: 0 8px;
    margin: 0 0 0 10px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: #3b0a11;
    color: #fca5a5;
    border-width: 2px;
    border-top-color: #ff4d5e;
    border-left-color: #ff4d5e;
    border-right-color: #881337;
    border-bottom-color: #881337;
    border-radius: 0;
}

.war-surrender-pc-btn.hovered {
    background-color: #5c101b;
    color: #ffffff;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #ff4d5e;
    border-bottom-color: #ff4d5e;
}

.war-pc-bar-track {
    flex-direction: row;
    width: 100%;
    height: 32px;
    background-color: #020508;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #102436;
    border-left-color: #102436;
    border-right-color: #2f567c;
    border-bottom-color: #2f567c;
    border-radius: 0;
}

.war-pc-player-fill {
    height: 100%;
    width: 50%;
    flex-shrink: 0;
    background-color: #22c55e;
}

.war-pc-bar-divider {
    width: 6px;
    height: 100%;
    flex-shrink: 0;
    background-color: #ffffff;
}

.war-pc-enemy-fill {
    height: 100%;
    width: 50%;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: #dc2626;
}

/* ---------- AREA INFERIOR ---------- */
.war-lower-area {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    overflow: visible;
}

.war-attributes-column {
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    margin-bottom: -8px;
    overflow: visible;
}

.war-attr-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 8px;
    overflow: visible;
}

/* Icone ao lado esquerdo da barra (placeholder: icones de Economia e Povo) */
.war-attr-icon {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: #060d14;
    -unity-background-scale-mode: scale-to-fit;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #102436;
    border-left-color: #102436;
    border-right-color: #2f567c;
    border-bottom-color: #2f567c;
    border-radius: 0;
}

.war-icon-tech {
    background-image: url('project://database/Assets/Sprites/moneynew.png?fileID=21300000&guid=1ff9b9ecfbad1924eb51f51a6f3863ec&type=3#moneynew');
}

.war-icon-troops {
    background-image: url('project://database/Assets/Sprites/peopleSlider.png?fileID=1537655665&guid=f498b99f7dc683646b439a837578e287&type=3#peopleSlider');
}

/* Barra fina horizontal de 4 niveis: critico (vermelho), baixo (laranja), medio (amarelo), alto (verde) */
.war-level-bar {
    flex-direction: row;
    flex-grow: 1;
    height: 40px;
}

.war-level-seg {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin-right: 5px;
    background-color: #050d17;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #102436;
    border-left-color: #102436;
    border-right-color: #2f567c;
    border-bottom-color: #2f567c;
    border-radius: 0;
}

.war-level-seg.war-seg-4 {
    margin-right: 0;
}

.war-level-seg-fill {
    height: 100%;
    width: 0%;
}

.war-fill-1 { background-color: #ef4444; }
.war-fill-2 { background-color: #f97316; }
.war-fill-3 { background-color: #facc15; }
.war-fill-4 { background-color: #22c55e; }

/* Seta de variacao (aparece entre a barra e o botao) */
.war-attr-arrow {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin: 0 8px;
    background-color: #060b12;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #386087;
    border-left-color: #386087;
    border-right-color: #102436;
    border-bottom-color: #102436;
    border-radius: 0;

    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
}

/* ---------- BOTAO DE INVESTIR (+) ---------- */
.war-btn-slot {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    overflow: visible;
}

.war-invest-plus-btn {
    width: 60px;
    height: 60px;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: #0d2b1d;
    color: #4ade80;
    padding: 0;
    margin: 0;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #4ade80;
    border-left-color: #4ade80;
    border-right-color: #166534;
    border-bottom-color: #166534;
    border-radius: 0;
}

.war-invest-plus-btn.hovered {
    background-color: #194d34;
    color: #ffffff;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-right-color: #22c55e;
    border-bottom-color: #22c55e;
}

.war-invest-plus-btn.btn-disabled {
    background-color: #070d12;
    color: #475569;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #334a61;
    border-left-color: #334a61;
    border-right-color: #132230;
    border-bottom-color: #132230;
}

/* ---------- TOOLTIP DISCRETO SOBRE O BOTAO (ICONE + BARRA + %) ---------- */
.war-invest-tooltip {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 4px;
    width: 150px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding: 2px 5px;
    background-color: #060d14;
    border-width: 2px;
    border-radius: 0;
}

.tooltip-economy {
    border-color: #eab308;
}

.tooltip-people {
    border-color: #f472b6;
}

.tooltip-mini-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.tooltip-icon-economy {
    background-image: url('project://database/Assets/Sprites/moneynew.png?fileID=21300000&guid=1ff9b9ecfbad1924eb51f51a6f3863ec&type=3#moneynew');
}

.tooltip-icon-people {
    background-image: url('project://database/Assets/Sprites/peopleSlider.png?fileID=1537655665&guid=f498b99f7dc683646b439a837578e287&type=3#peopleSlider');
}

.tooltip-mini-track {
    flex-grow: 1;
    height: 10px;
    margin: 0 5px;
    background-color: #020508;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #0d2238;
    border-left-color: #0d2238;
    border-right-color: #2b5278;
    border-bottom-color: #2b5278;
}

.tooltip-mini-fill {
    height: 100%;
    width: 50%;
}

.tooltip-economy .tooltip-mini-fill {
    background-color: #facc15;
}

.tooltip-people .tooltip-mini-fill {
    background-color: #f472b6;
}

.tooltip-mini-value {
    font-size: 14px;
    color: #ffffff;
    letter-spacing: 1px;
    -unity-font-style: bold;
    min-width: 36px;
    -unity-text-align: middle-right;
}

/* ---------- BARRA DE INVESTIMENTOS DISPONIVEIS (VERTICAL, DISCRETA) ---------- */
.war-invest-column {
    width: 120px;
    flex-shrink: 0;
    margin-left: 14px;
    flex-direction: column;
    align-items: center;
}

.war-invest-label {
    font-size: 11px;
    color: #94a3b8;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.war-invest-bar {
    flex-direction: column-reverse;
    flex-grow: 1;
    width: 78px;
    margin-top: -3px;
}

.war-invest-seg {
    flex-grow: 1;
    flex-basis: 0;
    width: 100%;
    margin-top: 4px;
    background-color: #051321;

    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: #0d2238;
    border-left-color: #0d2238;
    border-right-color: #29547d;
    border-bottom-color: #29547d;
    border-radius: 0;
}

.war-invest-seg-fill {
    width: 100%;
    height: 0%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #0284c7;
    border-top-width: 3px;
    border-top-color: #38bdf8;
}
